#    include_script_2=$2
#    echo \$include_script_2: $include_script_2
#    if [ -e "/usr/local/bin/$include_script_2" ] && [ -x "/usr/local/bin/$include_script_2" ]; then
#            /usr/local/bin/$include_script_2
#        echo "To end a session issue \"uncenz-kill \
#<the counterpart script of the $include_script_2> <Enter>\" from this terminal."
#        else
#            echo "The include script you gave:"
#            echo "$include_script_2"
#            echo "does not exist, or is not in the /usr/local/bin/ directory,"
#            echo "or is not executable"
#            sleep 3
#            show_help
#            exit 0
#    fi
#else
#    echo "To end a session issue \"uncenz-kill <Enter>\" from this terminal."
#fi
OPTIND=1
while getopts "hkr:" opt; do
    case "$opt" in
        h)
            show_help
            exit 0
            ;;
        k)
            chk-tls
            sleep 0.20
            if [ -e "$uncenz_run/chk-tls_calls_exit" ]; then
                ls -l $uncenz_run/chk-tls_calls_exit
                exit 1
            #else
            #    echo $?
            fi
            ;;
        r)
            if [ "X$OPTARG" != "X" ]; then 
                if [ -e "/usr/local/bin/$OPTARG" ] && [ -x "/usr/local/bin/$OPTARG" ]; then
                    $OPTARG
                    sleep 0.20
                    if [ -e "$uncenz_run/${OPTARG}_calls_exit" ]; then
                        ls -l $uncenz_run/${OPTARG}_calls_exit
                        exit 1
                    fi
                fi
            else
                echo "You gave an empty argument, or something else is wrong."
            fi
            ;;
    esac
done
shift $(($OPTIND - 1))

#if [ -e ".uncenz-include2_abort" ]; then
#    echo "The $include_script_2 mandates to abort the session."
#    echo "########################################"
#    echo; echo "We are aborting."; echo; echo
