#
# This is the first phase of my method. We try and start the screencast
# capturing with FFmpeg and tracing with dumpcap/tcpdump.
#

. /home/$USER/.uncenz.conf

#echo ". uncenz-setup from ${0##*/}"
. uncenz-setup

CUR_DIR=$(pwd)
#echo \$CUR_DIR: $CUR_DIR
if [ ! -n "$UNCENZ_DIR" ] || [ "X${UNCENZ_DIR}" == "X" ]; then
    echo "UNCENZ_DIR must be set in /home/$USER/.uncenz.conf"
    echo "sleep 3 and exit"
    sleep 3
    exit 0
else
    if [ "$CUR_DIR" != "$UNCENZ_DIR" ]; then
        echo "You are in:"
        ls -ld $CUR_DIR
        echo "but you must be in $UNCENZ_DIR to run ${0##*/},"
        echo "sleep 3 and exit"
        sleep 3
        exit 0
    fi
fi

function ask()
{
    echo -n "$@" '[y/n] ' ; read ans
    case "$ans" in
        y*|Y*) return 0 ;;
        *) return 1 ;;
    esac
}

function show_help {
    echo
    echo "==============================================================="
    echo
    echo "${0##*/} -- first phase of uncenz,"
    echo "starting screencasting and packet capturing"
    echo
    echo "Usage: ${0##*/} <an-include-script-with-capture-filters> <another-one>"
    echo "Or even:"
    echo "${0##*/} \"\" <another-one>"
    echo "(to run, at end, just the other extra one)."
    echo ""
    echo "  Without arguments uncenz captures in promiscuous mode,"
    echo "  on all available interfaces."
    echo
    echo "  With first argument, an executable file \$include_filter_run,"
    echo "  it starts the $dumper with whatever its capture filter contains."
    echo "  \$include_filter_run is named with no spaces, and resides"
    echo "  where the ${0##*/} is regularly run from,"
    echo "  usually in /usr/local/bin ."
    echo
}

# The includes below must reside in same dir as $0 (usually /usr/local/bin/),
# and they are plain non-exec files
. uncenz-ip6-per-conf

. uncenz-ipt

. uncenz-vnc-per-conf

. uncenz-dumper

sudo -s rm -v /home/*/Pas-*.txt &> /dev/null ; sudo -s rm -v /mnt/n?/home/*/Pas-*.txt &> /dev/null &
# First, the checks that apply to uncenz-1st run with and without the include
# alike.
#
# To be able to later decrypt traffic the $SSLKEYLOGFILE must be in place, so:
if [ ! -e "$SSLKEYLOGFILE" ]; then
    echo "There is no $SSLKEYLOGFILE. Fix that before you go online!"
    exit 0
fi

if [ "$SSLKEYLOGFILE_READY" != "y" ]; then
    echo \$SSLKEYLOGFILE_READY: $SSLKEYLOGFILE_READY
    echo "Pls. manage $SSLKEYLOGFILE, and set"
    echo "SSLKEYLOGFILE_READY=y in /home/$USER/.uncenz.conf"
    echo "sleep 3 and exit"
    sleep 3
    exit 0
fi

. uncenz-gpg

if [ "$INTERIM" == "y" ]; then
    echo uncenz-inter-kill.sh
    read NOP
    uncenz-inter-kill.sh
fi
# We must not start ffmpeg nor dumpcap/tcpdump if another session is running.
if [ "$TERM" == "xterm" ]; then
    recpid=$(sudo -s ps aux | grep 'ffmpeg' | grep -v grep | grep x11grab | awk '{ print $2 }')
    if [ -n "$recpid" ]; then
        echo \$recpid: $recpid
    fi
fi
if [ "$TERM" == "foot" ]; then
    recpid=$(sudo -s ps aux | grep 'wf-recorder' | grep -v grep | awk '{ print $2 }')
    if [ -n "$recpid" ]; then
        echo \$recpid: $recpid
    fi
fi
    
dupid=$(sudo -s ps aux | grep "$dumper" | grep -v grep | awk '{ print $2 }')
if [ -n "$dupid" ]; then
    echo "\$dupid: $dupid"
#else
#    echo "No $dumper running."
fi

# If our x11grab'ing FFmpeg/Wayland wf-recorder is running, we can't really (re)start uncenz'ing.
if [ -n "$recpid" ] && [ "X${recpid}X" != "XX" ] ; then
    echo "An ffmpeg/wf-recorder process is running, and it likely is uncenz's." ; echo
    ls -ltr | tail -4 ; sleep 2 ; echo
    ls -ltr | tail -4 ; sleep 1
    echo "Enter y/Y when you have killed FFmpeg/wf-recorder if it indeed is the uncenz one,"
    echo "or allowed it if it is a non-related FFmpeg/wf-recorder run."
    echo "(Hit anything other than y/Y and we will exit.)"
    ask 
    if [ "$?" == 0 ]; then
        echo "Move on by users choice."
    else
        exit 0
    fi
fi
# To start uncenz'ing the uncenz's $dumper also should not be running.
if [ -n "$dupid" ] || [ "X${dupid}X" != "XX" ] ; then
    echo "An $dumper process is running, and it likely is uncenz's." ; echo
    ls -ltr | tail -4 ; sleep 2 ; echo
    ls -ltr | tail -4 ; sleep 1
    echo "Enter y/Y when you have killed $dumper if it indeed is the uncenz one,"
    echo "or allowed it if it is a run non-related to uncenz."
    echo "(Hit anything other than y/Y and we will exit.)"
    ask 
    if [ "$?" == 0 ]; then
        echo "Move on by users choice."
    else
        exit 0
    fi
fi
# This uncenz-1st script starts concurrently (as close as possible) ffmpeg
# screencasting and network packet capturing. The two files that it will
# produce with those processes that it will start, it needs to name with the
# same timestamp infix, and so the first thing to run is actually the
# uncenz-ts:
#
uncenz-ts
ts=$(<$uncenz_run/uncenz-ts)
tsh=${ts}_${hst}
#echo \$tsh: $tsh
if [ -e "$uncenz_run/uncenz-ts.old" ]; then
    ts_old=$(<$uncenz_run/uncenz-ts.old)
    tsh_old=${ts_old}_${hst}
fi
#
# This stows the name to use in a file $uncenz_run/uncenz-ts (ts is for
# "time stamp"), such as "150207_0636" for 2015-02-06 06:36.
#

. uncenz-tlskeylog

the_dump=dump_${tsh}.pcap
the_cast=Screen_${tsh}.mkv
if [ "$dumper" == "dumpcap" ]; then
    sudo -s touch $the_dump
fi
if [ "$dumper" == "tcpdump" ]; then
    echo sudo -s touch $the_dump
    sudo -s touch $the_dump
    echo sudo -s chown tcpdump:tcpdump $the_dump
    sudo -s chown tcpdump:tcpdump $the_dump
fi
#TO_DO convert uncenz-ipt-conf-states.sh to an include
# Sometimes I like to take the state of the network when I'm online before I disconnect
# (this is not to be taken every time by default, it's a lot, like debugging)
#   echo
#   echo "the iptables, and the link layer conf states"
#   echo "      will be taken in 30 sec          "
#   echo "sleep 30 &&  sudo -s uncenz-ipt-conf-states.sh &"
#   sleep 30 &&  sudo -s uncenz-ipt-conf-states.sh &
#   sleep 1.5
#   echo
#

#TO_DO check if any of this old way I used to do it exist, revise/delete them
#if [ "$1" ] && [ -n "$1" ] && [ "X${1}" != "X" ]; then
#    include_filter_run=$1
#    echo \$include_filter_run: $include_filter_run
#    if [ -e "/usr/local/bin/$include_filter_run" ] && [ -x "/usr/local/bin/$include_filter_run" ]; then
#            /usr/local/bin/$include_filter_run
#        else
#            echo "The include script you gave:"
#            echo "$include_filter_run"
#            echo "does not exist, or is not in the /usr/local/bin/ directory,"
#            echo "or is not executable"
#            sleep 3
#            show_help
#            exit 0
#    fi
#fi
if [ "$TERM" == "xterm" ]; then
    POSITION="-g 80x4+500+0"
    FONT_SIZE="-fn 8x13"
else
    POSITION=""
    FONT_SIZE=""
fi
OPTIND=1
while getopts "hf:kr:" opt; do
    case "$opt" in
        h)
            show_help
            exit 0
        ;;
        f)
            case "$OPTARG" in
                "nofilter" )
                    FILTER_ARGS=""
                ;;
                "nolocal" )
                    FILTER_ARGS="-f net not 192.168.88.0 mask 255.255.255.0 and net not 192.168.2.0 mask 255.255.255.0 and net not 192.168.3.0 mask 255.255.255.0"
                ;;
                "read_args" )
                    echo "Type (or paste) the filter expression: "
                    read args_read
                    echo \$args_read: $args_read
                    FILTER_ARGS="-f $args_read"
                ;;
                "file_with_args" )
                    echo "Don't forget: the one-liner file must start with \"-f \" "
                    echo "and here give its full path, or it must be in current dir"
                    read the_filename
                    read NOP
                    FILTER_ARGS=$(<$the_filename)
                ;;
                * )
                    echo "The arg to -f is one of:" 
                    echo "nofilter nolocal read_args file_with_args" 
                    echo "Setting up \$FILTER_ARGS  to \"nofilter\""
                    FILTER_ARGS=""
                ;;
            esac
        ;;
        k)
            chk-tls
            sleep 0.20
            if [ -e "$uncenz_run/chk-tls_calls_exit" ]; then
                ls -l $uncenz_run/chk-tls_calls_exit
                exit 1
            fi
        ;;
        r)
            if [ "X$OPTARG" != "X" ]; then 
                script_to_run="$OPTARG" # but is run at end
            else
                echo "You gave an empty argument, or something else is wrong."
            fi
        ;;
    esac
done
#echo \$FILTER_ARGS: $FILTER_ARGS
shift $(($OPTIND - 1))

if [ "$dumper" == "dumpcap" ]; then
    echo "WARNING: dumpcap has not been tested for the "-C" option addition"
    echo "let alone $FILTER_ARGS (or anything else at all for years)"
    read NOP
    sudo -s $dumper -i any -C 300 -w $the_dump $FILTER_ARGS &
fi
if [ "$dumper" == "tcpdump" ]; then
    dupid=$(sudo -s ps aux | grep "$dumper" | grep -v grep | awk '{ print $2 }')
    while [ "X$dupid" == "X" ]; do
        ## Tried but couldn't get it to work in Wayland with foot
        ##$TERM $POSITION $FONT_SIZE -e sudo -s $dumper -C 300 -i any -U -v -w $the_dump $FILTER_ARGS &
        #echo "$TERM $POSITION $FONT_SIZE -e sudo -s $dumper -C 300 -i any -U -v -w $the_dump $FILTER_ARGS &"
        $TERM $POSITION $FONT_SIZE -e sudo -s $dumper -C 300 -i any -U -v -w $the_dump $FILTER_ARGS &

        #echo -n "Not running? pls. run manually, separate teminal."
        sleep 0.3
        dupid=$(sudo -s ps aux | grep "$dumper" | grep -v grep | awk '{ print $2 }')
    done
fi
sleep 0.2

sudo -s touch $the_cast
sudo -s chown $USER:$USER $the_cast

if [ "$TERM" == "xterm" ]; then
    if [ ! -n "${SCR}" ] || [ "X${SCR}X" == "XX" ]; then
        # debug
        echo "in $0"
        read NOP
        echo "You need to set your screen resolution in:"
        ls -l /home/$USER/.uncenz.conf
        show_help
    fi
    echo \$SCR: $SCR
    # if in /home/$USER/.uncenz.conf var is DISPLAY as in man ffmpeg-all, there is
    # no launching xterm:
    # xterm: Xt error: Can't open display: 0.0
    if [ ! -n "$FF_DISPLAY" ] || [ "X${FF_DISPLAY}" == "X" ]; then
        FF_DISPLAY=0.0
    fi
    echo \$FF_DISPLAY: $FF_DISPLAY
    # Not checking for mistaken entries, user needs to know what (s)he is doing.
    echo "will be: Monitor screen $SCR, take notice!"; sleep 0.5
    read NOP
    ffmpeg -y -f x11grab -nostdin -loglevel quiet -s $SCR -r 2 -i :$FF_DISPLAY \
        -c:v libx264 -preset ultrafast -threads 0 \
        $the_cast &
    
    echo "Monitor screen $SCR, take notice!"; sleep 0.5
    read NOP
    
    # We need to find the pid of each of the above processes.
    # ff for ffmpeg, du for $dumper
    recpid=$(sudo -s ps aux | grep 'ffmpeg' | grep -v grep | grep x11grab | awk '{ print $2 }')
fi
if [ "$TERM" == "foot" ]; then
    wf-recorder -c libx265 -p g=20 -f $the_cast &> /dev/null & recpid=$!
fi

dupid=$(sudo -s ps aux | grep "$dumper" | grep -v grep | awk '{ print $2 }')

echo \$recpid is: $recpid
echo $recpid > $uncenz_run/uncenz-rec.pid
# Note that if $dumper is tcpdump you get two pids, because it shows as two
# processes, one owned by sudo, the other by user tcpdump
# I've been using only tcpdump for capturing traffic since years now. Reports
# for dumpcap as $dumper welcome.
echo \$dupid is: $dupid
echo $dupid > $uncenz_run/uncenz-du.pid

#sudo -s tail -1 /var/log/syslog
#sudo -s tail -1 /var/log/syslog|cut -d\[ -f2|cut -d] -f1
# WARNING: this $str0 extraction works correcly only if you in:
# 'str0' stands for 'string 0', i.e. from where in the log we will later, at
# termination of this session, grep out the excerpt of the log.
#str0=$(sudo -s tail -1 /var/log/syslog|awk '{ print $1 }')
str0=$(sudo -s journalctl -o short-iso-precise -S-500 | tail -n1 | awk '{print $1}')
echo \$str0: $str0
echo $str0 > $uncenz_run/uncenz-log_str0
cat $uncenz_run/uncenz-log_str0

if [ -e "/usr/local/bin/$script_to_run" ] && [ -x "/usr/local/bin/$script_to_run" ]; then
    $script_to_run
    sleep 0.20
    if [ -e "$uncenz_run/${script_to_run}_calls_exit" ]; then # delete this if, does not apply
        ls -l $uncenz_run/${script_to_run}_calls_exit
        exit 1
    fi
fi

#if [ -e ".uncenz-include2_abort" ]; then
#    echo "The $include_script_2 mandates to abort the session."
#    echo "########################################"
#    echo; echo "We are aborting."; echo; echo
#    uncenz-kill
#    echo; echo "The session has been aborted.";
#    echo "as $include_script_2 requested"; echo; echo
#    echo "########################################"
#fi
# I added a similar snippet in the uncenz-kill, without which this $2 include
# may not work (say if it's about extracting from another log).

exit 0
