#!/bin/bash
#
# uncenz-2nd -- second phase, perusal of (a series of)
#            uncenz-1st -made screencast(s) and trace(s)
#            worked with (primitive) workPCAPs scripts
#
# (this is a rewrite after a number of failed attempts; it's primitive, but
# does allow quick analysis of main events by using now-improved uncenz-1st
# results)
#
# this script is part the uncenz set of scripts:
# https://github.com/miroR/uncenz
#
# This script runs on the produce of:
# https://github.com/miroR/workPCAPs
#
# Copyright 2015, Miroslav Rovis, www.CroatiaFidelis.hr
#
# released under BSD license, pls. see LICENSE
#
function ask()
{
    echo -n "$@" '[y/n] ' ; read ans
    case "$ans" in
        y*|Y*) return 0 ;;
        *) return 1 ;;
    esac
}
# When this rewrite was introduced, it could only work on all the PCAPs in a
# dir. Introducing (ah, getopts would be best, but the strategy to go for is
# far from clear to me yet) the list of PCAPs as first option (as in
# workPCAPs main script).
if [ $# -eq 0 ]; then
    echo "give (a list of) PCAP(s)"
    echo "(if globbing, you need to quote it, e.g.:"
    echo "uncenz-2nd \"*.pcap\")"
    exit 0
fi

# You need to be in the directory where you ran uncenz-1st (or where you copied
# over all its produce, i.e. the PCAP and the dump_<the-time-stamp>_messages
# and the screencasts and other. The dump_<the-time-stamp>_r represents another
# log extracted. That can be by any script you wrote and ran as third arg to
# uncenz-1st.
# Similarly dump_<the-time-stamp>-msg_r_PDU.txt is some produce by your own
# scripts. 
# First the PCAP-work.sh is run (see workPCAPs link above). Then
# this script.
PCAPs=$1
PCAPs_tr=$(ls -1 $1 | tr '\012' ' ')
echo "ls -1 $PCAPs|sed 's/\.pcap//'"
ls -1 $PCAPs|sed 's/\.pcap//'
echo
for i in $(ls -1 $PCAPs|sed 's/\.pcap//'); do
    ls -l $i.pcap
    read FAKE
    TMP="$(mktemp -d "/tmp/$i.$$.XXXXXXXX")"
    ls -ld $TMP
    read FAKE
    ls -ld ${i}_tHostsConv/
    ls -l ${i}_tHostsConv/
    ls -ld ${i}_tHostsConv/
    read FAKE
    scr=$(echo $i|sed 's/dump_\(.*\)/Screen_\1.mkv/')
    scr_bare=$scr
    scrg2=$(echo $i|sed 's/dump_\(.*\)/Screen_\1-g2.mkv/')
    scrg2_0=$(echo $scrg2|sed 's/-g2.mkv/-g2-0.mkv/')
    scrg2_base=${scrg2%*.mkv}
    # debug, del 3 ln
    echo \$scrg2_base: $scrg2_base
    echo \$scrg2_0: $scrg2_0
    echo \$scrg2: $scrg2
    read FAKE
    # Set at start here separately, because this will be the usual case for
    # working on archived PCAPs. Namely $scrg2 and $scrg2_0 will not be kept,
    # as they are usually 5-8 times larger than original $scr.
    if [ -e ".$scrg2_base.CMD" ] && [ -e ".$scrg2_base-0" ]; then
        if [ ! -e "$scrg2" ]; then
            if [ ! -e "$scrg2_0" ]; then
               chmod 755 .$scrg2_base.CMD
               ./.$scrg2_base.CMD
               chmod 644 .$scrg2_base.CMD
            fi
        fi
    fi
    if [ ! -e ".$scrg2_base.CMD" ]; then
        echo "ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2" \
            > .$scrg2_base.CMD_pre # the full .$scrg2_base.CMD may need
        cat .$scrg2_base.CMD_pre
        echo "(cat .$scrg2_base.CMD_pre)"
        ls -l .$scrg2_base.CMD_pre
        echo "(is base for .$scrg2_base.CMD)"
        read FAKE
    fi
    # may be the sole content of it, but only if $i.pcap and $src are synced
    # when originally captured
    if [ ! -e "$scrg2_0" ]; then # Before perusal of course only $scr there.
                                 # if we have $scrg2_0 it should be final, no
                                 # $scrg2 needed, in the perusal-state. For
                                 # archive-state only $scr (orig) is kept
                                 # ($scrg{,_0}'s are large), IOW either $srg2_0 is
                                 # sufficient (perusal-state) or $scr orig and
                                 # .$scrg2_base.CMD must exist, archive-state
                                 # (after perusal). Only the .$scrg2_base.CMD
                                 # could add to original archive, in which,
                                 # basically, no files are changed since
                                 # creation during online capture
        if [ ! -e "$scrg2" ]; then
            echo "To properly play the $scr and move in it to around 2 sec precision"
            echo "\"ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2\" is needed"
            ask "NOT do that? (default, just Enter, will do it)"
            if [ "$?" == 0 ]; then
                echo "User refused to create $scrg2"
            else
                #echo "ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2" \
                #    > .$scrg2_base.CMD_pre # the full .$scrg2_base.CMD may need
                #                           # more
                ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2
                scr="$scrg2"
            fi
        else
            # first round perusal, we don't yet know at what NNsec.MMMmilisec
            # offset to sync $scr and $i.pcap
            touch .$scrg2_base.CMD_advise
            scr="$scrg2"
        fi
    else
        scr="$scrg2_0"
    fi
    ls -l $scr
    echo "NOT run: mplayer $scr ?"
    ask
    if [ "$?" == 0 ]; then
        echo "mplayer $scr"
        echo "not run by user choice"
    else
        if [ ! -e ".$scrg2_base.CMD" ]; then
            # $scrg2_0 .$scrg2_base.CMD must both exist, in normal workflow,
            # so if any of the two is missing, it must be created from the
            # other. Give warning to user to create the missing .$scrg2_base.CMD.
            echo "=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="
            echo "$scrg2_0 was (previously) made; will be mplayed"
            echo "However, pls. create .$scrg2_base.CMD"
            echo "(needed for archiving, when only $scr_bare is kept)"
            echo "(another reminder shortly)"
            touch .$scrg2_base.CMD_advise
            ls -l .$scrg2_base.CMD_advise
            echo "(sleep 5)"
            echo "=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="
            sleep 5
        fi
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo "Next is:"
            echo mplayer $scr
            echo "NOTE: You are advised to, during/upon perusal, create:"
            echo ".$scrg2_base.CMD"
            echo "manually, so take down the exact name(s) needed, above and below here"
            if [ -e ".$scrg2_base.CMD_pre" ]; then
                echo "So use also:"
                cat .$scrg2_base.CMD_pre
                echo "(cat .$scrg2_base.CMD_pre)"
                ls -l .$scrg2_base.CMD_pre
                echo "for first line of .$scrg2_base.CMD"
            fi
            echo "and you should create it/or you can instead fill a filename:"
            echo " .$scrg2_base-0 "
            echo "with sole content of Nhour:NNsec.NNNmilisec of the offset"
            echo "and before the end of this session I'll create .$scrg2_base.CMD"
            # such as "0:03.500" without quotes
            echo "mplayer $scr now"
            read FAKE
            mplayer $scr & scr_pid=$!
        else
            mplayer -really-quiet $scr & scr_pid=$!
        fi
        echo $scr_pid > $TMP/${i}_scr.pid
        echo $(<$TMP/${i}_scr.pid)
        read FAKE
    fi
    cd ${i}_tHostsConv/
    echo "ls -1tr *.pcap"
    ls -1tr *.pcap
    read FAKE
    ls -1tr *.pcap > $TMP/${i}_PCAPlist
    echo "cat $TMP/${i}_PCAPlist"
    cat $TMP/${i}_PCAPlist
    read FAKE
    cd -
    read FAKE
    ls -dl ${i}_tHostsConv/
    ls -l ${i}_tHostsConv/
    ls -dl ${i}_tHostsConv/
    read FAKE
    cd  ${i}_tHostsConv
    ls -1tr . ../${i}_messages ../${i}_tHostsConv.log ../${i}_r \
        ../${i}_r_dt ../${i}_r_tb ../${i}-msg_r_PDU.txt \
        | grep -v '\.pcap\|SSLKEYLOGFILE.txt\|hosts-worked-ls-1' \
        | grep -v '\.:'|grep '[[:print:]]'
    read FAKE
    touch $TMP/${i}_list
    echo "Possible old (previous) lists: "
    for old_list in $(ls -1 ../${i}_list_*); do
        if [ -e "$old_list" ]; then
        echo "Possible candidate for resumption:"
            ls -l $old_list
            cat $old_list
            ls -l $old_list
        echo "(possible candidate for resumption)"
        read FAKE
        fi
    done
    for old_list in $(ls -1 ../${i}_list_*); do
        echo "You've seen all lists, we can currently resume only one of them."
        echo "Resume the old list (after you Enter to cat it first): "
        read FAKE
        cat $old_list
        echo "(cat $old_list)"
        ls -l $old_list
        echo " ?"
        ask
        if [ "$?" == 0 ]; then
            cat $old_list > $TMP/${i}_list    
        fi
    done
    # ../${i}_tHostsConv/tsh*log is old-style, will be abandoned
    # for ../${i}_tHostsConv.log
    if [ ! -e "$TMP/${i}_list" ] || [ ! -s "$TMP/${i}_list" ]; then
        echo "No list resumed. Creating the list:"
        echo "${i}_list"
        echo "now mandatory."
        for file in $(ls -1tr . ../${i}_messages \
            ../${i}_r_dt ../${i}_r_tb ../${i}_r_v \
            ../${i}_r ../${i}-msg_r_PDU.txt \
            | grep -v '\.pcap\|SSLKEYLOGFILE.txt\|hosts-worked-ls-1\|_127.0.0.1_\|CMD' \
            | grep -v '\.hosts$' | grep -v '\.:' | grep '[[:print:]]'); do
            if [ -e "$file" ]; then
                echo "$file" >> $TMP/${i}_list
            fi
        done
        if [ -e "../${i}_r.d/" ]; then
            ls -1 ../${i}_r.d/ > $TMP/${i}_list_r_d.unordered
            echo \$i: $i
            read FAKE
            echo "cat $TMP/${i}_PCAPlist|sed "s/${i}_\(.*\)\.pcap/\1/"\
|grep -v 127.0.0.1|grep -v 224.0.0.1|grep -v 255.255.255.255\
|grep -v 0.0.0.0|grep -v dump_"
            cat $TMP/${i}_PCAPlist|sed "s/${i}_\(.*\)\.pcap/\1/"\
                |grep -v 127.0.0.1|grep -v 224.0.0.1|grep -v 255.255.255.255\
                |grep -v 0.0.0.0|grep -v dump_
            read FAKE
            for ip_pcap in $(cat $TMP/${i}_PCAPlist|sed "s/${i}_\(.*\)\.pcap/\1/"\
                |grep -v 127.0.0.1|grep -v 224.0.0.1|grep -v 255.255.255.255\
                |grep -v 0.0.0.0|grep -v dump); do
                if [ "X${ip_pcap}" == "X" ]; then
                    echo "it's empty, discarding"
                    echo "($ip_pcap: $ip_pcap)"
                    echo "will \"continue\" here"
                    read FAKE
                    continue
                fi
                ls -l $TMP/${i}_list_r_d.unordered
                mv -v $TMP/${i}_list_r_d.unordered $TMP/${i}_list_r_d.unordered_temp
                echo "grep \$ip_pcap \$TMP/${i}_list_r_d.unordered_temp"
                echo "grep $ip_pcap $TMP/${i}_list_r_d.unordered_temp"
                grep $ip_pcap $TMP/${i}_list_r_d.unordered_temp
                read FAKE
                grep $ip_pcap $TMP/${i}_list_r_d.unordered_temp >> $TMP/${i}_list
                grep -v $ip_pcap $TMP/${i}_list_r_d.unordered_temp
                grep -v $ip_pcap $TMP/${i}_list_r_d.unordered_temp \
                    > $TMP/${i}_list_r_d.unordered
                ls -l $TMP/${i}_list_r_d.unordered $TMP/${i}_list_r_d.unordered_temp
                read FAKE
                sed "s/\(${i}_r_.*${ip_pcap}\.log\)/\.\.\/${i}_r\.d\/\1/" $TMP/${i}_list
                read FAKE
                sed  -i "s/\(${i}_r_.*${ip_pcap}\.log\)/\.\.\/${i}_r\.d\/\1/" $TMP/${i}_list
                #file=
                #echo "../${i}_r.d/$file" >> $TMP/${i}_list
            done
            # Learn about Bash misteries! I left this by mistake (just try and
            # uncomment that one line, and the files listed in the content of
            # this file were misteriously diappearing, the entire dir: 
            #$TMP/${i}_list_r_d.unordered_temp
        fi
        echo
        echo "-=-=-"
        echo $TMP/${i}_list is:
        cat $TMP/${i}_list
        ls -l $TMP/${i}_list
        cat $TMP/${i}_list | wc -l
        echo "  entries"
        echo "-=-=-"
        echo "NOTE: in a separate terminal you may now edit $TMP/${i}_list"
        read FAKE_permanent
        # Fixing the ${i}_list for new ${i}_conv-ip_l.txt listing, merged from part of
        # ../${i}_tHostsConv.log and ${i}.conv-ip
        if [ -e "../${i}_conv-ip_l.txt" ] && [ -s "../${i}_conv-ip_l.txt" ]; then
            grep -v "${i}_tHostsConv.log\|${i}.conv-ip\>" $TMP/${i}_list
            read FAKE
            grep -v "${i}_tHostsConv.log\|${i}.conv-ip\>\|${i}_list" \
                $TMP/${i}_list > ${i}_list_tmp
            diff ${i}_list_tmp $TMP/${i}_list
            read FAKE
            echo  ../${i}_conv-ip_l.txt > ${i}_list
            cat ${i}_list_tmp >> ${i}_list
            mv -v ${i}_list $TMP/${i}_list
            read FAKE
            rm -v ${i}_list_tmp
            cat ../${i}_conv-ip_l.txt
            echo "(cat ../${i}_conv-ip_l.txt)"
        else
            echo "${i}_conv-ip_l.txt not extant or empty."
            echo "Pls. mend for that, and hit Enter."
            echo "(and if it still will not be right, we'll exit)"
            read FAKE_permanent
            if [ ! -e "../${i}_conv-ip_l.txt" ] || [ ! -s "../${i}_conv-ip_l.txt" ]; then
            echo "${i}_conv-ip_l.txt is essential for this script."
            echo "And is either not extant or empty. Can't work."
                exit 1
            fi
        fi
    fi
    # Adding the list to be shown as the last tab in Vim
    echo $TMP/${i}_list >> $TMP/${i}_list
    echo "The list of files to view in Vim is prepared."
    echo "And if you want to add other files for viewing next,"
    echo "edit the list."
    echo "Open the list in Vim for editing?"
    echo "(it will also open in a tab in Vim for editing later)"
    ask
    if [ "$?" == 0 ]; then
        vim $TMP/${i}_list
    fi
    mkdir -pv /home/$USER/.uncenz-2nd/
    echo "NOT view these files in Vim (not launch Vim with them in tabs?"
    echo "(Enter for launching Vim to open those files):"
    ask
    if [ "$?" == 0 ]; then
        echo "User didn't choose to run Vim with the files in tabs."
    else
        # conv-ip_l.sh took/will take the measures, we (then will) want to open
        # an appropriate xterm of its own
        # "w_v" [w]idth for [v]im
        if [ ! -e "../.${i}_conv-ip_l.tw" ]; then
            cd ..
            ls -l .${i}_conv-ip_l.tw
            ask "is required, probably need to run conv-ip_l.sh $i.pcap hit Enter or y/Y to exit"
            if [ "$?" == 0 ]; then
                echo "User chose to exit here."
            else
                if [ -e ".${dump}_conv-ip_FIX_source" ]; then
                    echo "Manually fix ${i} conv-ip_l.sh source and hit Enter"
                    read FAKE_permanent
                fi
                conv-ip_l.sh $i.pcap
            fi
            cd -
        fi
        w_v=$(<../.${i}_conv-ip_l.tw)
        cat ../.${i}_conv-ip_l.tw
        ls -l ../.${i}_conv-ip_l.tw
        echo \$w_v: $w_v
        read FAKE
        # "h_v" [h]ight for [v]im
        h_v=50
        echo \$h_v: $h_v
        echo "view -p $(<$TMP/${i}_list)" > CMD_raw
        cat CMD_raw | tr '\012' '@' | sed 's/@/ /g' > CMD
        echo >> CMD
        chmod 755 CMD
        rm CMD_raw
        read FAKE
        prev_x_v_l_file_extant=""
        prev_x_v_t_file_extant=""
        if [ -e "/home/$USER/.uncenz-2nd/" ]; then
            # removing old pids files of non-running processes
            for vim_pid_file in $(ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'); do
                vim_pid=$(</home/$USER/.uncenz-2nd/$vim_pid_file)
                echo \$vim_pid: $vim_pid
                 read FAKE
                if ( ps aux | grep "\<$vim_pid\>" | grep -q -v grep ); then
                    ps aux | grep "\<$vim_pid\>"
                    #ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1
                    prev_x_v_l_file=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1)
                    prev_x_v_l=$(</home/$USER/.uncenz-2nd/$prev_x_v_l_file)
                    #ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1
                    echo \$prev_x_v_l: $prev_x_v_l
                     read FAKE
                    prev_x_v_t_file=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1)
                    prev_x_v_t=$(</home/$USER/.uncenz-2nd/$prev_x_v_t_file)
                    echo \$prev_x_v_t: $prev_x_v_t
                     read FAKE
                    prev_x_v_l_file_extant="$prev_x_v_l_file"
                    prev_x_v_t_file_extant="$prev_x_v_t_file"
                else
                    rm -v /home/$USER/.uncenz-2nd/$vim_pid_file
                    pcap_pid_file=$(echo $vim_pid_file|sed 's/_x_v/_x_p/')
                    l_file=$(echo $vim_pid_file|sed 's/\.pid/\.l/')
                    t_file=$(echo $vim_pid_file|sed 's/\.pid/\.t/')
                    rm -v /home/$USER/.uncenz-2nd/$pcap_pid_file /home/$USER/.uncenz-2nd/$l_file \
                        /home/$USER/.uncenz-2nd/$t_file
                    ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'|tail -1
                    #prev_vim_pid_file_extant=$(ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'|tail -1)
                    prev_x_v_l_file_extant=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1)
                    prev_x_v_t_file_extant=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1)
                    prev_x_v_l=$(</home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant)
                    prev_x_v_t=$(</home/$USER/.uncenz-2nd/$prev_x_v_t_file_extant)
                fi
            done
            # debug 6 ln
            #echo \$prev_vim_pid_file_extant: $prev_vim_pid_file_extant
            echo \$prev_x_v_l_file_extant: $prev_x_v_l_file_extant
            echo \$prev_x_v_t_file_extant: $prev_x_v_t_file_extant
            ls -l /home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant
            ls -l /home/$USER/.uncenz-2nd/$prev_x_v_t_file_extant
            echo \$prev_x_v_l: $prev_x_v_l
            echo \$prev_x_v_t: $prev_x_v_t
             read FAKE
            if [ "X$(ls -1 /home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant)" == "X" ] && \
                [ "X$(ls -1 /home/$USER/.uncenz-2nd/$prev_x_t_l_file_extant)" == "X" ]; then
                echo in main
                l=50; t=20      # distance from [l]eft edge / [t]op edge of the screen
            else
                echo in else
                let l=$prev_x_v_l+30
                let t=$prev_x_v_t+13
            fi
             read FAKE
        fi
        echo ${l} > /home/$USER/.uncenz-2nd/${i}_x_v.l
        echo ${t} > /home/$USER/.uncenz-2nd/${i}_x_v.t
        echo "Will run next:"
        echo "xterm -g ${w_v}x${h_v}+${l}+${t} -fn \"-misc-fixed-medium-r-normal--13-120-75-75-c-80-iso10646-1\" \
-e \"`pwd`/CMD\" &"
        read FAKE
        xterm -g ${w_v}x${h_v}+${l}+${t} -T ${i}_VIM -fn "-misc-fixed-medium-r-normal--13-120-75-75-c-80-iso10646-1" \
            -e "`pwd`/CMD" & x_v_pid=$!     # [x]term [v]im pid
        echo $x_v_pid > /home/$USER/.uncenz-2nd/${i}_x_v.pid
        sleep 10 && rm CMD &
        let h_p=$h_v-15
        let t_p=$t+88
        cd ..
        echo "Will run next:"
        echo "xterm -g ${w_v}x${h_p}+${l}+${t_p} -title ${i}_PCAP -fn \"-misc-fixed-medium-r-normal--13-120-75-75-c-80-iso10646-1\" "
        read FAKE
        xterm -g ${w_v}x${h_p}+${l}+${t_p} -title ${i}_PCAP -fn "-misc-fixed-medium-r-normal--13-120-75-75-c-80-iso10646-1" & \
            #-e "`pwd`/CMD" & # no CMD for now, however ${i}_PCAP xterm is placed to be companion to ${i}_VIM xterm
         x_p_pid=$!     # [x]term [p]cap pid
        echo $x_p_pid > /home/$USER/.uncenz-2nd/${i}_x_p.pid
        cd -
    fi
    # If ${i}_list is saved, will get this timestamp:
    ts=$(date +%y%m%d_%H%M)
    echo $ts # ts is for timestamp
    read FAKE
    echo "The list: "
    ls -l $TMP/${i}_list
    echo "cat $TMP/${i}_list"
    cat $TMP/${i}_list
    echo "Do you want to save that list as:"
    echo "${i}_list_${ts} ?"
    ask
    if [ "$?" == 0 ]; then
        touch ../${i}_list_${ts}
        echo "cat $TMP/${i}_list"
        cat $TMP/${i}_list
        read FAKE
        echo "ls -l ../${i}_list_${ts}"
        ls -l ../${i}_list_${ts}
        read FAKE
        echo \$TMP: $TMP
        cat $TMP/${i}_list|wc -l
        list_nr_lines=$(cat $TMP/${i}_list|wc -l)
        echo \$list_nr_lines: $list_nr_lines
        grep -v '_list' $TMP/${i}_list > ../${i}_list_${ts}
        list_nr_lines_minus=$(cat ../${i}_list_${ts}|wc -l)
        echo \$list_nr_lines_minus: $list_nr_lines_minus
        ls -l ../${i}_list_${ts}
        cat ../${i}_list_${ts}
    else
        echo "list not saved by user choice"
    fi
    cd -
    # Before termination of all created jobs, sync $i.pcap and $scr
    # (likely its derivative). Note that there's no talk if no .$scrg2_base.CMD_advise
    if [ -e ".$scrg2_base-0" ]; then
        ls -l .$scrg2_base-0
        cat .$scrg2_base-0
        echo "(cat .$scrg2_base-0)"
        ls -l .$scrg2_base-0
    else
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo ".$scrg2_base-0 does not exist"
        fi
    fi
    if [ -e ".$scrg2_base.CMD_pre" ]; then
        cat .$scrg2_base.CMD_pre
        echo "(cat .$scrg2_base.CMD_pre)"
        ls -l .$scrg2_base.CMD_pre
    else
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo ".$scrg2_base.CMD_pre does not exist"
        fi
    fi
    if [ -e ".$scrg2_base.CMD" ]; then
        cat .$scrg2_base.CMD
        echo "(cat .$scrg2_base.CMD)"
        ls -l .$scrg2_base.CMD
    else
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo "Pls. mend for the above missing requisites,"
            echo "(in case any is missing)"
            echo "We next will try and create .$scrg2_base.CMD"
            echo "(needed for archiving, when only $scr_bare is kept)"
            echo "and hit Enter"
            read FAKE_permanent
            if [ -e ".$scrg2_base-0" ] && [ -e ".$scrg2_base.CMD_pre" ]; then 
                parts_start=$(<.$scrg2_base-0)
                echo \$parts_start: $parts_start
                cat .$scrg2_base.CMD_pre >> .$scrg2_base.CMD
                if [ "$parts_start" != "0:00.000" ]; then
                    echo "mkvmerge -o ${scrg2_base}-0.mkv --split parts:$parts_start- $scrg2" \
                        >> .$scrg2_base.CMD
                    mkvmerge -o ${scrg2_base}-0.mkv --split parts:$parts_start- $scrg2
                else
                    echo "#mkvmerge -o ${scrg2_base}-0.mkv --split parts:$parts_start- $scrg2" \
                        >> .$scrg2_base.CMD
                    echo "mv -iv $scrg2 ${scrg2_base}-0.mkv" >> .$scrg2_base.CMD
                    mv -iv $scrg2 ${scrg2_base}-0.mkv
                    ln -s ${scrg2_base}-0.mkv $scrg2
                fi
                cat .$scrg2_base.CMD
                echo "(cat .$scrg2_base.CMD)"
                ls -l .$scrg2_base.CMD
            else
                echo "At least one of these two are inextant:"
                ls -l .$scrg2_base-0 .$scrg2_base.CMD_pre
                echo "Not creating .$scrg2_base.CMD ."
                echo "Run uncenz-2nd again on $i.pcap"
                echo "or create .$scrg2_base.CMD manually."
            fi
        fi
    fi
    # Another job before termination is removal of $scr temps.
    if [ -e ".$scrg2_base.CMD_advise" ]; then
        rm -v .$scrg2_base.CMD_advise
    fi
    if [ -e ".$scrg2_base.CMD_pre" ]; then
        rm -v .$scrg2_base.CMD_pre
    fi
    if [ -e "$scrg2_0" ] && [ -e "$scrg2" ]; then
        # Mostly, if $scrg2_0, $scrg2 not needed
        rm -v $scrg2
        read FAKE
    fi
    if [ -e "$scrg2_0" ]; then
        # Keep $scrg2_0 or not? Probably remove. If short duration, easy to
        # recreate, if long, too large. However, on repeated analysis, keep
        # yet! So, ask with '-i'.
        ls -l $scrg2_0
        rm -iv $scrg2_0
    fi
    echo "NOT terminate all windows opened with this run of ${0##/}?"
    echo "default: do terminate (just hit Enter)"
    echo "This choice will leave all windows opened,"
    echo "and the mplayer with the screencast running."
    ask
    if [ "$?" == 0 ]; then
        echo "All windows left open/running"
        echo "(excluding those not (yet) taken pid of)"
    else
        for curjobs in $(ls -1 $TMP/${i}*.pid); do
            pid=$(cat $curjobs)
            echo \$pid: $pid
            echo kill $pid
            kill $pid
        done
        sleep 0.1
        rm -rf $TMP/
    fi
    trap "rm -rf $TMP/" EXIT INT TERM
    export TMP
done
ls -l $TMP
read FAKE
trap "rm -rf $TMP/" EXIT INT TERM
