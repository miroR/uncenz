#!/bin/bash
#
# uncenz-2nd -- second phase, perusal of (a series of)
#            uncenz-1st -made screencast(s) and trace(s)
#            worked with (primitive) workPCAPs scripts
#
# (this is a rewrite after a number of failed attempts; it's primitive, but
# does allow quick analysis of main events by using now-improved uncenz-1st
# results)
#
# this script is part of the uncenz set of scripts:
# https://github.com/miroR/uncenz
#
# This script runs on the produce of:
# https://github.com/miroR/workPCAPs
#
# Copyright 2015, 2020, 2023 Miroslav Rovis, <https://www.CroatiaFidelis.hr/>
#
# released under BSD license, pls. see LICENSE
#

. /home/$USER/.uncenz.conf

echo ". uncenz-setup from ${0##*/}"
. uncenz-setup

function ask()
{
    echo -n "$@" '[y/n] ' ; read ans
    case "$ans" in
        y*|Y*) return 0 ;;
        *) return 1 ;;
    esac
}

function cat_ls_file () {
    if [ -e "$1" ]; then
        cat $1
        ls -l $1
        echo "(cat/ls -l $1)"
        read NOP
    else
        echo "$1 non extant"; echo 
    fi
}

function ls_file () {
    if [ -e "$1" ]; then
        ls -l $1
        echo "(ls -l $1)"
        read NOP
    else
        echo "$1 non extant"; echo 
    fi
}

if [ $# -eq 0 ]; then
    echo "give (a list of) PCAP(s)"
    echo "(if globbing, you need to quote it, e.g.:"
    echo "uncenz-2nd \"*.pcap\")"
    exit 0
fi

# You need to be in the directory where you copied over all the produce of
# uncenz-1st, i.e. the PCAP and the dump_<the-time-stamp>_messages, possibly
# other logs and the screencasts.
# The dump_<the-time-stamp>_r_<something> represents example of another
# log/other extracted. That can be by any script you wrote and ran giving it as
# arg to uncenz-1st's switch -r.
# First the PCAP-work-sep.sh is run (see workPCAPs link above). Then
# this script.

PCAPs=$1

> .pcaps-no-split
for i in $(ls -1 $PCAPs|sed 's/\.pcap//'); do
    # See uncenz-1st for these variables:
    # tsh=${ts}_${hst}
    # I used to rename files dump_$tsh.pcap{00,01,02,..} to files
    # dump_$ts-{00,01,02,..}_$hst.pcap on each of which PCAP-work-sep.sh is
    # run.
    # I would then join some of the produced dirs with data from those into
    # single dir for further processing, and there would be a symlink
    # dump_$tsh.pcap -> dump_$ts-00_$hst.pcap as name-base for scripts on them
    # all.
    # So work on those is accommodated with by this scriptas as well, although
    # it has not been tested recently.
    if ( echo $i | grep '\-[0-9][0-9]_' ); then
        echo "Not echoing the split PCAP to the list file:"
        ls -l $i.pcap
    else
        #TO_DO Do this without file .pcaps-no-split
        echo $i.pcap >> .pcaps-no-split
    fi
done
cat_ls_file .pcaps-no-split
PCAPs=$(<.pcaps-no-split)
    
for i in $(ls -1 $PCAPs|sed 's/\.pcap//'); do
    ls -l $i.pcap; echo
    TMP="$(mktemp -d "/tmp/$i.$$.XXXXXXXX")"
    ls -ld $TMP
    read NOP
    echo \$i: $i
    i_tmp=$i
    echo \$i_tmp: $i_tmp
    read NOP
    #TO_DO var i changes below from original at this for loop start. Not good.
    i=$(echo $i_tmp | sed 's/\(.*\)_\([a-z0-9A-Z][a-z0-9A-Z][a-z0-9A-Z].*\)/\1/')
    echo \$i: $i
    hst_p=$(echo $i_tmp | sed 's/\(.*\)_\([a-z0-9A-Z][a-z0-9A-Z][a-z0-9A-Z].*\)/\2/')
    echo \$hst_p: $hst_p
    i_h_p=${i}_${hst_p}
    echo \$i_h_p: $i_h_p
    # i_h_p is needed to work the
    # dump_<timestamp-{00,01,02,..}_$hst>.pcap. IOW when
    # ${i}_${hst}.pcap is symlink to ${i}-00_${hst}.pcap it is so for the
    # purpose of working on ${i}-{00,01,02,..}_${hst}.pcap. But I have not
    # tested this in long time.
    . cont_br_short
    scr=$(echo $i_h_p|sed 's/dump_\(.*\)/Screen_\1/'| sed 's/-00_/_/')
    echo \$scr: $scr
    read NOP
    if [ ! -e "$scr.mkv" ]; then
        # The case for no-screencasting captures (with uncenz-inter{,-kill}.sh)
        touch .${i_h_p}_no_scr
        ls -l .${i_h_p}_no_scr
        echo "Likely, this is an interim PCAP, without screencasting."
        echo "it has no screencast associated with it"
        echo "(unless it was lost or misnamed or other erroneous condition incurred)"
        read NOP
    fi
    # See above about the symlink dump_$tsh.pcap when
    # working on ${i}-{00,01,02,..}_${hst_p}.pcap .
    if [ -L "${i_h_p}.pcap" ]; then
        echo "if symlink main"
        read NOP
        for thostsconv in $(ls -1d ${i}-[0-9][0-9]_${hst_p}_tHostsConv); do
            ls -l ${thostsconv}
            ls -ld ${thostsconv}
            echo "(ls -l ${thostsconv})"
        done
        read NOP
        # Check on the split produce
        echo \${i_h_p}: ${i_h_p}
        read NOP
        touch .${i_h_p}_sym-pcap
        ls -l .${i_h_p}_sym-pcap
        read NOP
        ls -l ${i_h_p}.pcap
    else
        # if it is not any of those ${i}-{00,01,02,..}_${hst_p}.pcap plus the
        # symlink ${i}_${hst_p}.pcap but normal file ${i}_${hst_p}.pcap
        echo "if symlink else"
        ls -m ${i_h_p}_tHostsConv
        echo "(ls -m ${i_h_p}_tHostsConv)"
        ls -ld ${i_h_p}_tHostsConv
        read NOP
    fi
    if [ "$TERM" == "xterm" ]; then
        echo \$TERM: $TERM
    else
        echo \$TERM: $TERM  # alacritty
    fi
    pwd
    echo \$i: $i
    echo \$hst_p: $hst_p
    echo \$i_h_p: $i_h_p
    echo "Next is: NOT open ${i_h_p}.pcap with Wireshark?..."
    . cont_br_short
    if [ ! -e ".${i_h_p}_sym-pcap" ]; then
        ls -l ${i_h_p}.pcap
        ask "NOT open ${i_h_p}.pcap with Wireshark?"
        if [ "$?" == 0 ]; then
            echo "User declined to open ${i}_${hst_p}.pcap with Wireshark"
        else
            if [ -e "${i_h_p}_SSLKEYLOGFILE.txt" ]; then
                echo "wireshark -otls.keylog_file:${i_h_p}_SSLKEYLOGFILE.txt ${i_h_p}.pcap"
                wireshark -otls.keylog_file:${i_h_p}_SSLKEYLOGFILE.txt ${i_h_p}.pcap & pid=$!
                read NOP
            else
                echo "wireshark ${i_h_p}.pcap"
                wireshark ${i_h_p}.pcap & pid=$!
                read NOP
            fi
            echo $pid > $TMP/${i_h_p}_wireshark.pid
            cat_ls_file $TMP/${i_h_p}_wireshark.pid
        fi
    else
        echo \$i: $i
        echo \$hst_p: $hst_p
        read NOP
        echo "This:"
        ls -l ${i_h_p}.pcap
        echo "is the symlink of the first in a split PCAP series:"
        # However, can't work here without the $hst part, hardwired in uncenz to three letters.
        for split_pcap in $(ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap); do
            ls -l ${split_pcap}
        done
        #ls -l ${i}-[0-9][0-9]_${hst_p}.pcap
        echo "NOT open this series of split PCAPs with Wireshark?"
        ask "(currently only all or none)"
        if [ "$?" == 0 ]; then
            echo "User doesn't want to open these PCAPs."
        else
            echo "For default delay of 2sec just Enter, for your own delay, type it in: "
            echo "Must be an int like 3, or a float like 0.4"
            echo "WARNING: I'm doing no error checking!"
            read delay
            if [ ! -n "$delay" ]; then
                delay=2
            fi
            num_pid=0
            ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap
            if [ -e "${i_h_p}.SSLKEYLOGFILE.txt" ]; then
                for k in $(ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap|sed 's/\.pcap//'); do
                    echo "wireshark -otls.keylog_file:${k}_SSLKEYLOGFILE.txt $k.pcap"
                    wireshark -otls.keylog_file:${k}_SSLKEYLOGFILE.txt $k.pcap &
                    pid=$!
                    echo $pid
                    echo $pid > $TMP/${k}_wireshark_${num_pid}.pid
                    ls -l $TMP/${k}_wireshark_${num_pid}.pid
                    cat $TMP/${k}_wireshark_${num_pid}.pid
                    let num_pid=$num_pid+1
                    echo $num_pid: $num_pid
                    sleep $delay
                done
            else
                for k in $(ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap|sed 's/\.pcap//'); do
                    echo "wireshark $k.pcap"
                    wireshark $k.pcap &
                    pid=$!
                    echo $pid
                    echo $pid > $TMP/${k}_wireshark_${num_pid}.pid
                    ls -l $TMP/${k}_wireshark_${num_pid}.pid
                    cat $TMP/${k}_wireshark_${num_pid}.pid
                    let num_pid=$num_pid+1
                    echo $num_pid: $num_pid
                    sleep $delay
                done
            fi
        fi
    fi
    echo "Next is: Possible old (previous) lists: "
    . cont_br_short
    touch $TMP/${i_h_p}_list
    echo "Possible old (previous) lists: "
    for old_list in $(ls -1 ${i_h_p}_list_*); do
        if [ -e "$old_list" ]; then
        echo "Possible candidate for resumption:"
            cat $old_list
            ls -l $old_list
        echo "(possible candidate for resumption)"
        read NOP
        fi
    done
    for old_list in $(ls -1 ${i_h_p}_list_*); do
        echo "You've seen all lists, we can currently resume only one of them."
        echo "Resume the old list (after you Enter to cat it first): "
        read NOP
        cat $old_list
        echo "(cat $old_list)"
        ls -l $old_list
        echo " ?"
        ask
        if [ "$?" == 0 ]; then
            cat $old_list > $TMP/${i_h_p}_list    
        fi
    done
    if [ ! -e "$TMP/${i_h_p}_list" ] || [ ! -s "$TMP/${i_h_p}_list" ]; then
        echo "No list resumed. Creating the list:"
        echo "${i_h_p}_list"
        echo "now mandatory."
        read NOP
        # the namespace is ${i_h_p}_<FILES-EXCEPT-SOME>, there for analysis
        for file in $(ls -1d ${i_h_p}_conv-ip_l.txt \
            ${i_h_p}_NOTES.txt \
            ${i_h_p}_* \
            ${i_h_p}-msg_r_PDU*.txt \
            ${i_h_p}_tHostsConv/${i_h_p}.POST \
            ${i_h_p}_tHostsConv/${i_h_p}-frame-http-request-full_uri.txt \
            ${i_h_p}_tHostsConv/${i_h_p}-frame-http2-request-full_uri.txt \
            ${i_h_p}_rn.d/*.log \
            | grep -v '\.pcap\|SSLKEYLOGFILE.txt\|_127.0.0.1_\|^CMD\>' \
            | grep -v '_tStreams$\|_tHostsConv$\|_tHostsConv.log\|_files*' \
            | grep -v 'epoch\|\.tar\.gz\|_s_m_r_list' | grep -v "${i_h_p}_CMD" \
            | grep -v '\.hosts$' | grep -v '\.:' | uniq | grep '[[:print:]]'); do
            if [ -e "$file" ]; then
                echo "$file" >> $TMP/${i_h_p}_list
            fi
        done
        ls -l  $TMP/${i_h_p}_list
        echo "Next: \"cat $TMP/${i_h_p}_list\""
        read NOP
        echo "-=-=-"
        cat $TMP/${i_h_p}_list
        echo "    and it is:"
        echo -n "        "
        cat $TMP/${i_h_p}_list | wc -l
        echo "            entries, but it may not be complete yet"
        echo "-=-=-"
        ls -l ${i_h_p}_tHostsConv/${i_h_p}-frame-http-request-full_uri.txt
        ls -l ${i_h_p}_tHostsConv/${i_h_p}-frame-http2-request-full_uri.txt
        read NOP
        for ip in $( awk '{print $1}' ${i_h_p}_conv-ip_l.txt | grep '[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}' ); do
            echo $ip
            #read NOP
            if [ -e "${i_h_p}_tHostsConv/${i_h_p}_${ip}-frame-http-request-full_uri.txt" ]; then
                ls -l ${i_h_p}_tHostsConv/${i_h_p}_${ip}-frame-http-request-full_uri.txt
                echo ${i_h_p}_tHostsConv/${i_h_p}_${ip}-frame-http-request-full_uri.txt \
                    >> $TMP/${i_h_p}_list
            fi
            if [ -e "${i_h_p}_tHostsConv/${i_h_p}_${ip}-frame-http2-request-full_uri.txt" ]; then
                ls -l ${i_h_p}_tHostsConv/${i_h_p}_${ip}-frame-http2-request-full_uri.txt
                echo ${i_h_p}_tHostsConv/${i_h_p}_${ip}-frame-http2-request-full_uri.txt \
                    >> $TMP/${i_h_p}_list
            fi
        done
    fi
    # Adding the list to be shown as the last tab in Vim
    echo $TMP/${i_h_p}_list >> $TMP/${i_h_p}_list
    echo "The list of files to view in Vim is prepared."
    echo "And if you want to add other files for viewing next,"
    echo "edit the list."
    echo "Open the list in Vim for editing?"
    echo "(it will also open in a tab in Vim for editing later)"
    ask
    if [ "$?" == 0 ]; then
        vim $TMP/${i_h_p}_list
    fi
    mkdir -pv /home/$USER/.uncenz-2nd/
    echo "NOT view these files in Vim (not launch Vim with them in tabs)?"
    echo "Enter for launching Vim to open those files:"
    ask
    if [ "$?" == 0 ]; then
        echo "User declined to run Vim with the files in tabs."
    else
        echo "view -p $(<$TMP/${i_h_p}_list)" > CMD_raw
        cat CMD_raw | tr '\012' '@' | sed 's/@/ /g' > CMD
        echo >> CMD
        chmod 755 CMD
        rm -v CMD_raw
        read NOP
        if [ "$TERM" == "xterm" ]; then
            # conv-ip_l.sh took/will take the measures, we (then will) want to open
            # an appropriate xterm of its own
            # "w_v" [w]idth for [v]im
            if [ ! -e ".${i_h_p}_conv-ip_l.tw" ] && [ ! -s ".${i_h_p}_conv-ip_l.tw" ]; then
                ls -l .${i_h_p}_conv-ip_l.tw
                echo "is required, probably need to run:"
                echo "conv-ip_l.sh ${i_h_p}.pcap"
                ask "Hit Enter or y/Y to exit"
                if [ "$?" == 0 ]; then
                    echo "User chose to exit here."
                else
                    if [ -e ".${i_h_p}_conv-ip_FIX_source" ]; then
                        echo "Possibly you can manually fix ${i_h_p}.conv-ip_l source"
                        echo "an fix it by running the conv-ip_l.sh"
                        echo "If done, hit Enter!"
                        read NOP_permanent
                    fi
                    conv-ip_l.sh ${i_h_p}.pcap
                fi
            fi
            w_v=$(<.${i_h_p}_conv-ip_l.tw)
            #cat .${i_h_p}_conv-ip_l.tw
            #ls -l .${i_h_p}_conv-ip_l.tw
            echo \$w_v: $w_v
            #read NOP
            # "h_v" [h]ight for [v]im
            h_v=50
            echo \$h_v: $h_v
            prev_x_v_l_file_extant=""
            prev_x_v_t_file_extant=""
            if [ -e "/home/$USER/.uncenz-2nd/" ]; then
                # removing old pids files of non-running processes
                for vim_pid_file in $(ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'); do
                    vim_pid=$(</home/$USER/.uncenz-2nd/$vim_pid_file)
                    echo \$vim_pid: $vim_pid
                    #read NOP
                    if ( ps aux | grep "\<$vim_pid\>" | grep -q -v grep ); then
                        ps aux | grep "\<$vim_pid\>"
                        #ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1
                        prev_x_v_l_file=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1)
                        prev_x_v_l=$(</home/$USER/.uncenz-2nd/$prev_x_v_l_file)
                        #ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1
                        echo \$prev_x_v_l: $prev_x_v_l
                        #read NOP
                        prev_x_v_t_file=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1)
                        prev_x_v_t=$(</home/$USER/.uncenz-2nd/$prev_x_v_t_file)
                        echo \$prev_x_v_t: $prev_x_v_t
                        #read NOP
                        prev_x_v_l_file_extant="$prev_x_v_l_file"
                        prev_x_v_t_file_extant="$prev_x_v_t_file"
                    else
                        rm -v /home/$USER/.uncenz-2nd/$vim_pid_file
                        pcap_pid_file=$(echo $vim_pid_file|sed 's/_x_v/_x_p/')
                        l_file=$(echo $vim_pid_file|sed 's/\.pid/\.l/')
                        t_file=$(echo $vim_pid_file|sed 's/\.pid/\.t/')
                        rm -v /home/$USER/.uncenz-2nd/$pcap_pid_file /home/$USER/.uncenz-2nd/$l_file \
                            /home/$USER/.uncenz-2nd/$t_file
                        ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'|tail -1
                        #prev_vim_pid_file_extant=$(ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'|tail -1)
                        prev_x_v_l_file_extant=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1)
                        prev_x_v_t_file_extant=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1)
                        prev_x_v_l=$(</home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant)
                        prev_x_v_t=$(</home/$USER/.uncenz-2nd/$prev_x_v_t_file_extant)
                    fi
                done
                if [ "X$(ls -1 /home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant)" == "X" ] && \
                    [ "X$(ls -1 /home/$USER/.uncenz-2nd/$prev_x_t_l_file_extant)" == "X" ]; then
                    echo in main
                    l=50; t=20      # distance from [l]eft edge / [t]op edge of the screen
                else
                    echo in else
                    let l=$prev_x_v_l+30
                    let t=$prev_x_v_t+13
                fi
                #read NOP
            fi
            echo ${l} > /home/$USER/.uncenz-2nd/${i_h_p}_x_v.l
            echo ${t} > /home/$USER/.uncenz-2nd/${i_h_p}_x_v.t
            echo "Will run next:"
            echo "xterm -g ${w_v}x${h_v}+${l}+${t} -fn 8x13 -e \"`pwd`/CMD\" &"
            read NOP
            xterm -g ${w_v}x${h_v}+${l}+${t} -T ${i_h_p}_VIM -fn 8x13 \
                -e "`pwd`/CMD" & x_v_pid=$!     # [x]term [v]im pid
            echo $x_v_pid > /home/$USER/.uncenz-2nd/${i_h_p}_x_v.pid
            sleep 10 && rm CMD &
            let h_p=$h_v-15
            let t_p=$t+88
        else
            if [ "$TERM" == "alacritty" ]; then
                echo \$TERM: $TERM
            fi
            mv -iv CMD ${i_h_p}_CMD
            echo "Next is: alacritty -e $(<${i_h_p}_CMD)"
            read NOP
            alacritty -e $(<${i_h_p}_CMD) & a_v_pid=$!    # [a]lacritty [v]im pid
            echo $a_v_pid > $TMP/${i_h_p}_a_v.pid
            echo "(alacritty -e $(<${i_h_p}_CMD) &)"
            read NOP
        fi
    fi


    if [ -e "$scr.mkv" ]; then
        # debug, del 2 ln
        echo \$scr: $scr
        read NOP
    fi
    echo \$TERM: $TERM
    read NOP
    # Before perusal of course only $scr.mkv there.
    #
    # With Xorg casts, $scr-g2.mkv and $scr-g2_0.mkv are usually made
    # but will not be kept, as they are often 5-8 times larger than
    # original $scr.mkv.
    #
    # For Wayland casts, $scr-g2.mkv may often not be created, such as for
    # several hours casts, as it is too expensive and too large. Instead
    # the $scr-g2_0.mkv created from Wayland cast has only the 'g2' in name so
    # I can use the same script uncenz-scr_CMD_create.sh for both Wayland and
    # Xorg casts.
    #
    # Which script need only correct offset given in .$scr-g2-0
    #
    # For both Xorg and Wayland either $scr-g2_0.mkv is sufficient
    # (perusal-state) or $scr.mkv orig and/or .$scr-g2.CMD and .$scr-g2-0
    # should exist (archive-state), so $scr-g2_0.mkv can be re-created.
    #
    for file in .$scr-g2.CMD .$scr-g2-0 ; do
        cat_ls_file $file
    done
    ls_file $scr-g2_0.mkv

    echo "Next is if not exist .${i_h_p}_no_scr"
    . cont_br_short
    if [ ! -e ".${i_h_p}_no_scr" ]; then
        unset scr_g2_0_ok
        echo "Next is: NOT run: mpv $scr{,-g2,-g2_0}.mkv ?"
        . cont_br_short
        echo "NOT run: mpv $scr{,-g2,-g2_0}.mkv ?"
        ask
        if [ "$?" == 0 ]; then
            echo "mpv $scr{,-g2,-g2_0}.mkv"
            echo "not run by user's choice"
        else
            if [ -e "$scr-g2_0.mkv" ]; then
                ls_file $scr-g2_0.mkv
                scr_e=$scr-g2_0
                echo "Assuming the PCAP/screencast have already been synced."
            else
                if [ -e "$scr-g2.mkv" ]; then
                    ls_file $scr-g2.mkv
                    scr_e=$scr-g2
                else
                    ls_file $scr.mkv
                    scr_e=$scr
                fi
                echo "NOTE: With the offset in $scr.mkv that you will assess we will create next:"
                cat_ls_file .$scr-g2.CMD
                if [ -e ".$scr-g2-0" ]; then
                    # if non printing char in .$scr-g2-0, get rid of it
                    parts_start=$(<.$scr-g2-0)
                    if [ "X${parts_start}X" == "XX" ]; then
                        echo \$parts_start: $parts_start
                         > .$scr-g2-0
                    fi
                fi
                echo "You will be asked to input the offset to cut $scr from into the file:"
                cat_ls_file .$scr-g2-0
                echo "with sole content of Nmin:NNsec.NNNmilisec of the offset"
                echo "such as \"0:03.500\" without quotes."
            fi
            echo "NOTE: mpv will run in bg with terminal I/O disabled."
            echo "Do follow STDOUT here in this terminal!"
            echo "(just, once mpv starts, focus back to this terminal, and hit Enter)"
            echo "mpv --window-scale=0.95 -no-terminal $scr_e.mkv now"
            . cont_br_short
            mpv --window-scale=0.95 -no-terminal $scr_e.mkv & scr_pid=$!
            echo $scr_pid > $TMP/${i_h_p}_scr.pid
            echo $(<$TMP/${i_h_p}_scr.pid)
            read NOP
            if [ -e "$scr-g2_0.mkv" ] || [ -e ".$scr-g2-0" ] && [ -s ".$scr-g2-0" ] && [ -e ".$scr-g2.CMD" ] && [ -s ".$scr-g2.CMD" ]; then
                echo "We will check on these:"
                ls_file $scr-g2_0.mkv
                cat_ls_file .$scr-g2-0
                cat_ls_file .$scr-g2.CMD
                echo \$scr_g2_0_ok: $scr_g2_0_ok

                echo "Next is if not exist .$scr-g2_0.mkv"
                . cont_br_short
                # '&&' stronger then '||' ? Else script wrong!
                # This is the case with already worked and archived
                # PCAPs/screencast/other-related sets, that have all
                # been adjusted so that synced/perusable casts can be
                # re-created.
                if [ ! -e "$scr-g2_0.mkv" ]; then
                    cat_ls_file .$scr-g2.CMD
                    ask "Execute it now?"
                    if [ "$?" == 0 ]; then  
                        chmod 755 .$scr-g2.CMD
                        ./.$scr-g2.CMD
                    else
                        echo "User declined to execute ./.$scr-g2.CMD"
                    fi
                    if [ -e ".$scr-g2-0" ] && [ -s ".$scr-g2-0" ]; then
                        parts_start=$(<.$scr-g2-0)
                        echo \$parts_start: $parts_start
                    fi
                fi
                if [ -e "$scr-g2_0.mkv" ]; then
                    ls -l $scr-g2_0.mkv
                    echo "WARNING: to decline below may be DANGEROUS"
                fi
                ask "set scr_g2_0_ok to y, declining will rm -iv $scr-g2_0.mkv if exist"
                if [ "$?" == 0 ]; then
                    scr_g2_0_ok="y"
                else
                    if [ -e "$scr-g2_0.mkv" ]; then
                        rm -iv $scr-g2_0.mkv
                    fi
                fi
            else
                echo "Next is if not exist/empty .$scr-g2-0"
                . cont_br_short
                if [ ! -e ".$scr-g2-0" ] || [ ! -s ".$scr-g2-0" ]; then
                    cat_ls_file .$scr-g2-0
                    echo "###########################################################"
                    echo "Pls. input the offset to cut $scr.mkv from into the filename:"
                    ls -l .$scr-g2-0
                    echo "with sole content of Nmin:NNsec.NNNmilisec of the offset"
                    echo "such as "0:03.500" without quotes."
                    echo "WARNING: I am doing no error checking!"
                    echo "###########################################################"
                    while [ ! -n "$offset" ] || [ "X${offset}" == "X" ]; do
                        read offset
                        echo \$offset: $offset
                    done
                    echo "$offset" > .$scr-g2-0
                    cat_ls_file .$scr-g2-0
                else
                    cat_ls_file .$scr-g2-0
                fi
                parts_start=$(<.$scr-g2-0)
                echo \$parts_start: $parts_start
            fi
            echo \$scr_g2_0_ok: $scr_g2_0_ok
            read NOP
            echo "Next is while not exists \$scr-g2_0.mkv and \$scr_g2_0_ok not y"
            . cont_br_short
            while [ ! -e "$scr-g2_0.mkv" ] || [ "$scr_g2_0_ok" != "y" ]; do
                echo "uncenz-scr_CMD_create.sh $scr.mkv $parts_start"
                # $parts_start can even be not set, would work with 1st arg
                # but only if exists correct .$scr-g2-0 file
                uncenz-scr_CMD_create.sh $scr.mkv $parts_start
                echo "(${0##/}: uncenz-scr_CMD_create.sh $scr.mkv $parts_start)"
                echo
                ask "set \$scr_g2_0_ok to y, declining will rm -iv $scr-g2_0.mkv"
                if [ "$?" == 0 ]; then
                    scr_g2_0_ok="y"
                else
                    rm -iv $scr-g2_0.mkv
                fi
                echo \$scr_g2_0_ok: $scr_g2_0_ok
                read NOP
            done
        fi
    else
        echo "We stick: "
        ls_file .${i_h_p}_no_scr
        echo "Likely, this is an interim PCAP, without screencasting."
        echo "it has no screencast associated with it"
        echo "(unless it was lost or misnamed or other erroneous condition incurred)"
    fi

    echo "Next is prepare for archiving, as \$scr... manipulation should be over."
    . cont_br_short
    # Another job before termination is removal of $scr temps.
    if [ -e "$scr-g2_0.mkv" ] && [ -e "$scr-g2.mkv" ]; then
        # Mostly, if $scr-g2_0.mkv, $scr-g2.mkv not needed
        rm -v $scr-g2.mkv
        read NOP
    fi
    if [ -e "$scr-g2_0.mkv" ]; then
        # Keep $scr-g2_0.mkv or not? Probably remove. If short duration, easy to
        # recreate, if long, too large. However, on repeated analysis, keep
        # yet! So, ask with '-i'.
        ls -l $scr-g2_0.mkv
        rm -iv $scr-g2_0.mkv
    fi

    # If ${i_h_p}_list is saved, will get this timestamp:
    ts=$(date +%y%m%d_%H%M)
    echo $ts # ts is for timestamp
    read NOP
    echo "The list: "
    ls -l $TMP/${i_h_p}_list
    echo "cat $TMP/${i_h_p}_list"
    cat $TMP/${i_h_p}_list
    echo "Add an infix reminder shortcut, e.g. "some_par" if it is based on some parameter, to the list:"
    echo "The list will be saved as:"
    echo "${i_h_p}_list_<the-infix>_${ts} ?"
    read name
    if [ ! -n "$name" ]; then
        echo "Do you want to save that list anyway, the name will be:"
        echo "${i_h_p}_list_${ts} ?"
        ask
        if [ "$?" == 0 ]; then
            # touch to save the list
            touch .${i_h_p}_list_do_save
        else
            echo "list not saved by user choice"
        fi
    else
        # prefix _ to $name
        name="_${name}"
        echo \$name: $name
    fi
    if [ -n "$name" ] || [ -e ".${i_h_p}_list_do_save" ]; then
        touch ${i_h_p}_list${name}_${ts}
        echo "cat $TMP/${i_h_p}_list"
        cat $TMP/${i_h_p}_list
        read NOP
        echo "ls -l ${i_h_p}_list${name}_${ts}"
        ls -l ${i_h_p}_list${name}_${ts}
        read NOP
        echo \$TMP: $TMP
        cat $TMP/${i_h_p}_list|wc -l
        list_nr_lines=$(cat $TMP/${i_h_p}_list|wc -l)
        echo \$list_nr_lines: $list_nr_lines
        grep -v '_list' $TMP/${i_h_p}_list > ${i_h_p}_list${name}_${ts}
        list_nr_lines_minus=$(cat ${i_h_p}_list${name}_${ts}|wc -l)
        echo \$list_nr_lines_minus: $list_nr_lines_minus
        ls -l ${i_h_p}_list${name}_${ts}
        cat ${i_h_p}_list${name}_${ts}
    fi
    rm -v .${i_h_p}_list_do_save
    read NOP
    if [ -e ".pcaps-no-split" ]; then
        rm -v .pcaps-no-split
    fi
    echo "NOT terminate all windows opened with this run of ${0##/}?"
    echo "default: do terminate (just hit Enter)"
    echo "This choice will leave all windows opened,"
    echo "and the mpv with the screencast running."
    ask
    if [ "$?" == 0 ]; then
        echo "All windows left open/running"
        echo "(excluding those not taken pid of in $TMP)"
    else
        for curjobs in $(ls -1 $TMP/${i}*_${hst_p}*.pid); do
            pid=$(cat $curjobs)
            echo \$pid: $pid
            echo kill $pid
            kill $pid
        done
        sleep 0.1
        rm -rf $TMP/
    fi
    trap "rm -rf $TMP/" EXIT INT TERM
    export TMP
done
ls -l $TMP
read NOP
trap "rm -rf $TMP/" EXIT INT TERM
