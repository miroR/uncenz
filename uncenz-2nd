#!/bin/bash
#
# uncenz-2nd -- second phase, perusal of (a series of)
#            uncenz-1st -made screencast(s) and trace(s)
#            worked with (primitive) workPCAPs scripts
#
# (this is a rewrite after a number of failed attempts; it's primitive, but
# does allow quick analysis of main events by using now-improved uncenz-1st
# results)
#
# this script is part of the uncenz set of scripts:
# https://github.com/miroR/uncenz
#
# This script runs on the produce of:
# https://github.com/miroR/workPCAPs
#
# Copyright 2015, 2020 Miroslav Rovis, www.CroatiaFidelis.hr
#
# released under BSD license, pls. see LICENSE
#
function ask()
{
    echo -n "$@" '[y/n] ' ; read ans
    case "$ans" in
        y*|Y*) return 0 ;;
        *) return 1 ;;
    esac
}

if [ $# -eq 0 ]; then
    echo "give (a list of) PCAP(s)"
    echo "(if globbing, you need to quote it, e.g.:"
    echo "uncenz-2nd \"*.pcap\")"
    exit 0
fi

# You need to be in the directory where you ran uncenz-1st (or where you copied
# over all its produce, i.e. the PCAP and the dump_<the-time-stamp>_messages
# and the screencasts and other. The dump_<the-time-stamp>_r represents another
# log extracted. That can be by any script you wrote and ran as third arg to
# uncenz-1st.
# Similarly dump_<the-time-stamp>-msg_r_PDU*.txt is some produce by your own
# scripts. 
# First the PCAP-work.sh is run (see workPCAPs link above). Then
# this script.
PCAPs=$1
PCAPs_tr=$(ls -1 $1 | tr '\012' ' ')
echo "ls -1 $PCAPs|sed 's/\.pcap//'"
ls -1 $PCAPs|sed 's/\.pcap//'
echo

> .pcaps-no-split
for i in $(ls -1 $PCAPs|sed 's/\.pcap//'); do
    if ( echo $i | grep '\-[0-9][0-9]_' ); then
        echo "Not echoing the split PCAP the list:"
        ls -l $i.pcap
    else
        echo $i.pcap >> .pcaps-no-split
    fi
done
cat .pcaps-no-split
echo "(cat .pcaps-no-split)"
ls -l .pcaps-no-split
read FAKE
PCAPs=$(<.pcaps-no-split)
    
for i in $(echo $PCAPs|sed 's/\.pcap//'); do
    echo \$i: $i
done
read FAKE
    
for i in $(ls -1 $PCAPs|sed 's/\.pcap//'); do
    # Temporary. Remove below if:
    if [ ! -L "$i.pcap" ]; then
        ls -l $i.pcap
        . cont_br_short
    fi
    ls -l $i.pcap
    TMP="$(mktemp -d "/tmp/$i.$$.XXXXXXXX")"
    ls -ld $TMP
    read FAKE
    echo $i | sed 's/\(.*\)-[0-9][0-9]_[a-zA-Z][a-zA-Z][a-zA-Z].*/\1/'
    read FAKE
    echo \$i: $i
    i_tmp=$i
    echo \$i_tmp: $i_tmp
    read FAKE
    i=$(echo $i_tmp | sed 's/\(.*\)_\([a-zA-Z][a-zA-Z][a-zA-Z].*\)/\1/')
    echo \$i: $i
    echo $i_tmp | sed 's/\(.*\)_\([a-zA-Z][a-zA-Z][a-zA-Z]*\)/\2/'
    read FAKE
    hst_p=$(echo $i_tmp | sed 's/\(.*\)_\([a-zA-Z][a-zA-Z][a-zA-Z].*\)/\2/')
    #ls -l ${i}-[0-9][0-9]_[a-zA-Z][a-zA-Z][a-zA-Z]*.pcap
    echo \$hst_p: $hst_p
    i_h_p=${i}_${hst_p}
    echo \$i_h_p: $i_h_p
    read FAKE
    scr=$(echo $i_h_p|sed 's/dump_\(.*\)/Screen_\1.mkv/'| sed 's/-00_/_/')
    echo \$scr: $scr
    read FAKE
    if [ ! -e "$scr" ]; then
        # The case for no-screencasting captures (with uncenz-inter{,-kill}.sh)
        touch .${i_h_p}_no_scr
        ls -l .${i_h_p}_no_scr
        echo "(because, likely, it is an interim PCAP, without screencasting)"
    fi
    if [ -L "${i_h_p}.pcap" ]; then
        echo "if symlink main"
        read FAKE
        for thostsconv in $(ls -1d ${i}-[0-9][0-9]_${hst_p}_tHostsConv); do
            ls -l ${thostsconv}
            ls -ld ${thostsconv}
            echo "(ls -l ${thostsconv})"
        done
        read FAKE
        # Check on the split produce
        echo \${i_h_p}: ${i_h_p}
        read FAKE
        touch .${i_h_p}_sym-pcap
        ls -l .${i_h_p}_sym-pcap
        read FAKE
        ls -l ${i_h_p}.pcap
    else
        echo "if symlink else"
        ls -ld ${i_h_p}_tHostsConv
        ls -l ${i_h_p}_tHostsConv
        echo "(ls -l ${i_h_p}_tHostsConv)"
        read FAKE
    fi
    if [ -e "$scr" ]; then
        scr_bare=$scr
        scrg2=$(echo ${i_h_p}|sed 's/dump_\(.*\)/Screen_\1-g2.mkv/' | sed 's/-[0-9][0-9]_/_/')
        scrg2_0=$(echo $scrg2|sed 's/-g2.mkv/-g2-0.mkv/')
        scrg2_base=${scrg2%*.mkv}
        # debug, del 5 ln
        echo \$scr: $scr
        echo \$scr_bare: $scr_bare
        echo \$scrg2_base: $scrg2_base
        echo \$scrg2_0: $scrg2_0
        echo \$scrg2: $scrg2
        read FAKE
    fi
    # Set at start here separately, because this will be the usual case for
    # working on archived PCAPs. Namely $scrg2 and $scrg2_0 will not be kept,
    # as they are usually 5-8 times larger than original $scr.
    if [ -e ".$scrg2_base.CMD" ] && [ -e ".$scrg2_base-0" ] && [ -s ".$scrg2_base-0" ] && \
        [ ! -e ".${i_h_p}_no_scr" ]; then
        chmod 755 .$scrg2_base.CMD
        if [ ! -e "$scrg2" ]; then
            if [ ! -e "$scrg2_0" ]; then
               ./.$scrg2_base.CMD
               chmod 644 .$scrg2_base.CMD
            fi
        else
            tail -1 .$scrg2_base.CMD > .$scrg2_base.CMD_TMP
            chmod 755 .$scrg2_base.CMD_TMP
            ./.$scrg2_base.CMD_TMP
            rm -v .$scrg2_base.CMD_TMP
            chmod 644 .$scrg2_base.CMD
        fi
    fi
    if [ ! -e ".${i_h_p}_no_scr" ]; then
        echo "Made ${scrg2_base}-0.mkv ?"
        read NOP
    fi
    if [ ! -e ".$scrg2_base.CMD" ] && [ ! -e ".${i_h_p}_no_scr" ]; then
        echo "ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2" \
            > .$scrg2_base.CMD_pre # the full .$scrg2_base.CMD may need
        cat .$scrg2_base.CMD_pre
        echo "(cat .$scrg2_base.CMD_pre)"
        ls -l .$scrg2_base.CMD_pre
        echo "(is base for .$scrg2_base.CMD)"
        read FAKE
    fi
    # may be the sole content of it, but only if ${i_h_p}.pcap and $scr are synced
    # when originally captured
    if [ ! -e "$scrg2_0" ] && \
        [ ! -e ".${i_h_p}_no_scr" ]; then # Before perusal of course only $scr there.
                                      # if we have $scrg2_0 it should be final, no
                                      # $scrg2 needed, in the perusal-state. For
                                      # archive-state only $scr (orig) is kept
                                      # ($scrg{,_0}'s are large), IOW either $srg2_0 is
                                      # sufficient (perusal-state) or $scr orig and
                                      # .$scrg2_base.CMD must exist, archive-state
                                      # (after perusal). Only the .$scrg2_base.CMD
                                      # could add to original archive, in which,
                                      # basically, no files are changed since
                                      # creation during online capture
        if [ ! -e "$scrg2" ]; then
            echo "To properly play the $scr and move in it to around 2 sec precision"
            echo "\"ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2\" is needed"
            ask "NOT do that? (default, just Enter, will do it)"
            if [ "$?" == 0 ]; then
                echo "User declined to create $scrg2"
            else
                ffmpeg -i $scr -map 0:v -c:v libx264 -g 2 $scrg2
                scr="$scrg2"
            fi
        else
            # first round perusal, we don't yet know at what NNsec.MMMmilisec
            # offset to sync $scr and ${i_h_p}.pcap
            touch .$scrg2_base.CMD_advise
            scr="$scrg2"
        fi
    else
        scr="$scrg2_0"
    fi
    if [ -e "$scr" ]; then ls -l $scr ; fi
    if [ ! -e ".${i_h_p}_no_scr" ]; then
        echo "NOT run: mplayer $scr ?"
        ask
        if [ "$?" == 0 ]; then
            echo "mplayer $scr"
            echo "not run by user choice"
        else
            if [ ! -e ".$scrg2_base.CMD" ]; then
                # $scrg2_0 .$scrg2_base.CMD must both exist, in normal workflow,
                # so if any of the two is missing, it must be created from the
                # other. Give warning to user to create the missing .$scrg2_base.CMD.
                echo "=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="
                echo "$scrg2_0 was (previously) made; will be mplayed"
                echo "However, pls. create .$scrg2_base.CMD"
                echo "(needed for archiving, when only $scr_bare is kept)"
                echo "(another reminder shortly)"
                touch .$scrg2_base.CMD_advise
                ls -l .$scrg2_base.CMD_advise
                echo "(sleep 1.5)"
                echo "=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-="
                sleep 3.5
            fi
            if [ -e ".$scrg2_base.CMD_advise" ]; then
                echo "Next is:"
                echo mplayer $scr
                echo "NOTE: With the offset in $scr that you will assess we will create later:"
                echo ".$scrg2_base.CMD"
                if [ -e ".$scrg2_base.CMD_pre" ]; then
                    echo "We will use:"
                    cat .$scrg2_base.CMD_pre
                    echo "(cat .$scrg2_base.CMD_pre)"
                    ls -l .$scrg2_base.CMD_pre
                    echo "for first line of .$scrg2_base.CMD"
                fi
                echo
                echo "You will be asked to input the offset to cut $scr from into the filename:"
                touch .$scrg2_base-0
                ls -l .$scrg2_base-0
                echo "with sole content of Nhour:NNsec.NNNmilisec of the offset"
                echo "such as "0:03.500" without quotes."
                echo
                echo "And before the end of this session we will create:"
                echo ".$scrg2_base.CMD and run it."
                echo
                echo "NOTE: mplayer will run in bg. Do follow STDOUT here in this terminal!"
                echo "(just, once mplayer starts, focus back to this terminal, and hit Enter)"
                echo "mplayer $scr now"
                read FAKE
                mplayer $scr & scr_pid=$!
            else
                mplayer -really-quiet $scr & scr_pid=$!
            fi
            echo $scr_pid > $TMP/${i_h_p}_scr.pid
            echo $(<$TMP/${i_h_p}_scr.pid)
            read FAKE
        fi
    fi
    pwd
    echo \$i: $i
    echo \$hst_p: $hst_p
    echo \$i_h_p: $i_h_p
    read FAKE
    if [ ! -e ".${i_h_p}_sym-pcap" ]; then
        ls -l ${i_h_p}.pcap
        ask "NOT open ${i_h_p}.pcap with Wireshark?"
        if [ "$?" == 0 ]; then
            echo "User declined to open ${i}_${hst_p}.pcap with Wireshark"
        else
            if [ -e "${i_h_p}_SSLKEYLOGFILE.txt" ]; then
                echo "wireshark -ossl.keylog_file:${i_h_p}_SSLKEYLOGFILE.txt ${i_h_p}.pcap"
                wireshark -ossl.keylog_file:${i_h_p}_SSLKEYLOGFILE.txt ${i_h_p}.pcap & pid=$!
                read FAKE
            else
                echo "wireshark ${i_h_p}.pcap"
                wireshark ${i_h_p}.pcap & pid=$!
                read FAKE
            fi
            echo $pid > $TMP/${i_h_p}_wireshark.pid
            cat $TMP/${i_h_p}_wireshark.pid
            echo "(cat $TMP/${i_h_p}_wireshark.pid)"
            ls -l $TMP/${i_h_p}_wireshark.pid
        fi
    else
        echo \$i: $i
        echo \$hst_p: $hst_p
        read FAKE
        echo "This:"
        ls -l ${i_h_p}.pcap
        echo "is the symlink of the first in a split PCAP series:"
        # However, can't work here without the $hst part, hardwired in uncenz to three letters.
        for split_pcap in $(ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap); do
            ls -l ${split_pcap}
        done
        #ls -l ${i}-[0-9][0-9]_${hst_p}.pcap
        echo "NOT open this series of split PCAPs with Wireshark?"
        ask "(currently only all or none)"
        if [ "$?" == 0 ]; then
            echo "User doesn't want to open these PCAPs."
        else
            echo "For default delay of 2sec just Enter, for your own delay, type it in: "
            echo "Must be an int like 3, or a float like 0.4"
            echo "WARNING: I'm doing no error checking!"
            read delay
            if [ ! -n "$delay" ]; then
                delay=2
            fi
            num_pid=0
            ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap
            if [ -e "${i_h_p}.SSLKEYLOGFILE.txt" ]; then
                for k in $(ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap|sed 's/\.pcap//'); do
                    echo "wireshark -ossl.keylog_file:${k}_SSLKEYLOGFILE.txt $k.pcap"
                    wireshark -ossl.keylog_file:${k}_SSLKEYLOGFILE.txt $k.pcap &
                    pid=$!
                    echo $pid
                    echo $pid > $TMP/${k}_wireshark_${num_pid}.pid
                    ls -l $TMP/${k}_wireshark_${num_pid}.pid
                    cat $TMP/${k}_wireshark_${num_pid}.pid
                    let num_pid=$num_pid+1
                    echo $num_pid: $num_pid
                    sleep $delay
                done
            else
                for k in $(ls -1 ${i}-[0-9][0-9]_${hst_p}.pcap|sed 's/\.pcap//'); do
                    echo "wireshark $k.pcap"
                    wireshark $k.pcap &
                    pid=$!
                    echo $pid
                    echo $pid > $TMP/${k}_wireshark_${num_pid}.pid
                    ls -l $TMP/${k}_wireshark_${num_pid}.pid
                    cat $TMP/${k}_wireshark_${num_pid}.pid
                    let num_pid=$num_pid+1
                    echo $num_pid: $num_pid
                    sleep $delay
                done
            fi
        fi
    fi
    . cont_br_short
    echo \$i: $i
    echo \$hst_p: $hst_p
    echo \$i_h_p: $i_h_p
    read FAKE
    ls -1 ${i_h_p}_conv-ip_l.txt \
        ${i_h_p}_NOTES.txt \
        ${i_h_p}_messages ${i_h_p}_r \
        ${i_h_p}_r_dt ${i_h_p}_r_tb \
        ${i_h_p}_r_vd ${i_h_p}_r_vt ${i_h_p}_r_v \
        ${i_h_p}-msg_r_PDU*.txt \
        ${i_h_p}_tHostsConv/${i}*_${hst_p}.POST \
        ${i_h_p}_tHostsConv/${i}*_${hst_p}-frame-http-request-full_uri.txt \
        ${i_h_p}_tHostsConv/${i}*_${hst_p}_*-frame-http-request-full_uri.txt \
        ${i_h_p}_rn.d/*.log \
        | grep -v '\.pcap\|SSLKEYLOGFILE.txt' \
        | grep -v '\.:'|grep '[[:print:]]'
    read FAKE
    touch $TMP/${i_h_p}_list
    echo "Possible old (previous) lists: "
    for old_list in $(ls -1 ${i_h_p}_list_*); do
        if [ -e "$old_list" ]; then
        echo "Possible candidate for resumption:"
            cat $old_list
            ls -l $old_list
        echo "(possible candidate for resumption)"
        read FAKE
        fi
    done
    for old_list in $(ls -1 ${i_h_p}_list_*); do
        echo "You've seen all lists, we can currently resume only one of them."
        echo "Resume the old list (after you Enter to cat it first): "
        read FAKE
        cat $old_list
        echo "(cat $old_list)"
        ls -l $old_list
        echo " ?"
        ask
        if [ "$?" == 0 ]; then
            cat $old_list > $TMP/${i_h_p}_list    
        fi
    done
    if [ ! -e "$TMP/${i_h_p}_list" ] || [ ! -s "$TMP/${i_h_p}_list" ]; then
        echo "No list resumed. Creating the list:"
        echo "${i_h_p}_list"
        echo "now mandatory."
        read FAKE
        for file in $(ls -1 ${i_h_p}_conv-ip_l.txt \
            ${i_h_p}_NOTES.txt \
            ${i_h_p}_messages ${i_h_p}_r \
            ${i_h_p}_r_dt ${i_h_p}_r_tb \
            ${i_h_p}_r_dt ${i_h_p}_r_tb \
            ${i_h_p}_r_vd ${i_h_p}_r_vt ${i_h_p}_r_v \
            ${i_h_p}-msg_r_PDU*.txt \
            ${i_h_p}_tHostsConv/${i}*_${hst_p}.POST \
            ${i_h_p}_tHostsConv/${i}*_${hst_p}-frame-http-request-full_uri.txt \
            ${i_h_p}_tHostsConv/${i}*_${hst_p}_*-frame-http-request-full_uri.txt \
            ${i_h_p}_rn.d/*.log \
            | grep -v '\.pcap\|SSLKEYLOGFILE.txt\|_127.0.0.1_\|CMD' \
            | grep -v '\.hosts$' | grep -v '\.:' | grep '[[:print:]]'); do
            if [ -e "$file" ]; then
                echo "$file" >> $TMP/${i_h_p}_list
            fi
        done
        echo "Check: "
        cat $TMP/${i_h_p}_list
        echo "(cat $TMP/${i_h_p}_list)"
        read FAKE
        #if [ -e "${i_h_p}_rn.d/" ]; then
        #    ls -1 ${i_h_p}_rn.d/*| grep '\.log' >> $TMP/${i_h_p}_list
        #fi
        #echo
        echo "-=-=-"
        echo "  The list:"
        ls -l  $TMP/${i_h_p}_list
        cat $TMP/${i_h_p}_list
        echo "    is:"
        echo -n "        "
        cat $TMP/${i_h_p}_list | wc -l
        echo "            entries"
        echo "-=-=-"
        echo "NOTE: in a separate terminal you may now edit:"
        echo "$TMP/${i_h_p}_list"
        read FAKE_permanent
        # Fixing the ${i_h_p}_list for ${i_h_p}_conv-ip_l.txt listing, merged from part of
        # and ${i_h_p}.conv-ip
        #if [ -e "${i_h_p}_conv-ip_l.txt" ] && [ -s "${i_h_p}_conv-ip_l.txt" ]; then
        #    grep -v "\|${i_h_p}.conv-ip\>" $TMP/${i_h_p}_list
        #    read FAKE
        #    grep -v "\|${i_h_p}.conv-ip\>\|${i_h_p}_list" \
        #        $TMP/${i_h_p}_list > ${i_h_p}_list_tmp
        #    diff ${i_h_p}_list_tmp $TMP/${i_h_p}_list
        #    read FAKE
        #    echo  ${i_h_p}_conv-ip_l.txt > ${i_h_p}_list
        #    cat ${i_h_p}_list_tmp >> ${i_h_p}_list
        #    mv -v ${i_h_p}_list $TMP/${i_h_p}_list
        #    read FAKE
        #    rm -v ${i_h_p}_list_tmp
        #    cat ${i_h_p}_conv-ip_l.txt
        #    echo "(cat ${i_h_p}_conv-ip_l.txt)"
        #else
        #    echo "${i_h_p}_conv-ip_l.txt not extant or empty."
        #    echo "Pls. mend for that, and hit Enter."
        #    echo "(and if it still will not be right, we'll exit)"
        #    read FAKE_permanent
        #    if [ ! -e "${i_h_p}_conv-ip_l.txt" ] || [ ! -s "${i_h_p}_conv-ip_l.txt" ]; then
        #    echo "${i_h_p}_conv-ip_l.txt is essential for this script."
        #    echo "And is either not extant or empty. Can't work."
        #        exit 1
        #    fi
        #fi
    fi
    # Adding the list to be shown as the last tab in Vim
    echo $TMP/${i_h_p}_list >> $TMP/${i_h_p}_list
    echo "The list of files to view in Vim is prepared."
    echo "And if you want to add other files for viewing next,"
    echo "edit the list."
    echo "Open the list in Vim for editing?"
    echo "(it will also open in a tab in Vim for editing later)"
    ask
    if [ "$?" == 0 ]; then
        vim $TMP/${i_h_p}_list
    fi
    mkdir -pv /home/$USER/.uncenz-2nd/
    echo "NOT view these files in Vim (not launch Vim with them in tabs?"
    echo "(Enter for launching Vim to open those files):"
    ask
    if [ "$?" == 0 ]; then
        echo "User declined to run Vim with the files in tabs."
    else
        # conv-ip_l.sh took/will take the measures, we (then will) want to open
        # an appropriate xterm of its own
        # "w_v" [w]idth for [v]im
        if [ ! -e ".${i_h_p}_conv-ip_l.tw" ] && [ ! -s ".${i_h_p}_conv-ip_l.tw" ]; then
            ls -l .${i_h_p}_conv-ip_l.tw
            echo "is required, probably need to run:"
            echo "conv-ip_l.sh ${i_h_p}.pcap"
            ask "Hit Enter or y/Y to exit"
            if [ "$?" == 0 ]; then
                echo "User chose to exit here."
            else
                if [ -e ".${i_h_p}_conv-ip_FIX_source" ]; then
                    echo "Possibly you can manually fix ${i_h_p}.conv-ip_l source"
                    echo "an fix it by running the conv-ip_l.sh"
                    echo "If done, hit Enter!"
                    read FAKE_permanent
                fi
                conv-ip_l.sh ${i_h_p}.pcap
            fi
        fi
        w_v=$(<.${i_h_p}_conv-ip_l.tw)
        #cat .${i_h_p}_conv-ip_l.tw
        #ls -l .${i_h_p}_conv-ip_l.tw
        echo \$w_v: $w_v
        #read FAKE
        # "h_v" [h]ight for [v]im
        h_v=50
        echo \$h_v: $h_v
        echo "view -p $(<$TMP/${i_h_p}_list)" > CMD_raw
        cat CMD_raw | tr '\012' '@' | sed 's/@/ /g' > CMD
        echo >> CMD
        chmod 755 CMD
        rm CMD_raw
        #read FAKE
        prev_x_v_l_file_extant=""
        prev_x_v_t_file_extant=""
        if [ -e "/home/$USER/.uncenz-2nd/" ]; then
            # removing old pids files of non-running processes
            for vim_pid_file in $(ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'); do
                vim_pid=$(</home/$USER/.uncenz-2nd/$vim_pid_file)
                echo \$vim_pid: $vim_pid
                #read FAKE
                if ( ps aux | grep "\<$vim_pid\>" | grep -q -v grep ); then
                    ps aux | grep "\<$vim_pid\>"
                    #ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1
                    prev_x_v_l_file=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1)
                    prev_x_v_l=$(</home/$USER/.uncenz-2nd/$prev_x_v_l_file)
                    #ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1
                    echo \$prev_x_v_l: $prev_x_v_l
                    #read FAKE
                    prev_x_v_t_file=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1)
                    prev_x_v_t=$(</home/$USER/.uncenz-2nd/$prev_x_v_t_file)
                    echo \$prev_x_v_t: $prev_x_v_t
                    #read FAKE
                    prev_x_v_l_file_extant="$prev_x_v_l_file"
                    prev_x_v_t_file_extant="$prev_x_v_t_file"
                else
                    rm -v /home/$USER/.uncenz-2nd/$vim_pid_file
                    pcap_pid_file=$(echo $vim_pid_file|sed 's/_x_v/_x_p/')
                    l_file=$(echo $vim_pid_file|sed 's/\.pid/\.l/')
                    t_file=$(echo $vim_pid_file|sed 's/\.pid/\.t/')
                    rm -v /home/$USER/.uncenz-2nd/$pcap_pid_file /home/$USER/.uncenz-2nd/$l_file \
                        /home/$USER/.uncenz-2nd/$t_file
                    ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'|tail -1
                    #prev_vim_pid_file_extant=$(ls -1tr "/home/$USER/.uncenz-2nd/" | grep 'x_v\.pid'|tail -1)
                    prev_x_v_l_file_extant=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.l' | tail -1)
                    prev_x_v_t_file_extant=$(ls -1tr /home/$USER/.uncenz-2nd/ | grep 'x_v.t' | tail -1)
                    prev_x_v_l=$(</home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant)
                    prev_x_v_t=$(</home/$USER/.uncenz-2nd/$prev_x_v_t_file_extant)
                fi
            done
            # debug 6 ln
            #echo \$prev_vim_pid_file_extant: $prev_vim_pid_file_extant
            #echo \$prev_x_v_l_file_extant: $prev_x_v_l_file_extant
            #echo \$prev_x_v_t_file_extant: $prev_x_v_t_file_extant
            #ls -l /home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant
            #ls -l /home/$USER/.uncenz-2nd/$prev_x_v_t_file_extant
            #echo \$prev_x_v_l: $prev_x_v_l
            #echo \$prev_x_v_t: $prev_x_v_t
            #read FAKE
            if [ "X$(ls -1 /home/$USER/.uncenz-2nd/$prev_x_v_l_file_extant)" == "X" ] && \
                [ "X$(ls -1 /home/$USER/.uncenz-2nd/$prev_x_t_l_file_extant)" == "X" ]; then
                echo in main
                l=50; t=20      # distance from [l]eft edge / [t]op edge of the screen
            else
                echo in else
                let l=$prev_x_v_l+30
                let t=$prev_x_v_t+13
            fi
            #read FAKE
        fi
        echo ${l} > /home/$USER/.uncenz-2nd/${i_h_p}_x_v.l
        echo ${t} > /home/$USER/.uncenz-2nd/${i_h_p}_x_v.t
        echo "Will run next:"
        echo "xterm -g ${w_v}x${h_v}+${l}+${t} -fn \"-misc-fixed-medium-r-normal--13-120-75-75-c-80-iso10646-1\" \
-e \"`pwd`/CMD\" &"
        read FAKE
        xterm -g ${w_v}x${h_v}+${l}+${t} -T ${i_h_p}_VIM -fn "-misc-fixed-medium-r-normal--13-120-75-75-c-80-iso10646-1" \
            -e "`pwd`/CMD" & x_v_pid=$!     # [x]term [v]im pid
        echo $x_v_pid > /home/$USER/.uncenz-2nd/${i_h_p}_x_v.pid
        sleep 10 && rm CMD &
        let h_p=$h_v-15
        let t_p=$t+88
    fi
    # If ${i_h_p}_list is saved, will get this timestamp:
    ts=$(date +%y%m%d_%H%M)
    echo $ts # ts is for timestamp
    read FAKE
    echo "The list: "
    ls -l $TMP/${i_h_p}_list
    echo "cat $TMP/${i_h_p}_list"
    cat $TMP/${i_h_p}_list
    echo "Add an infix reminder shortcut, e.g. "_dt" if it is _dt only, to the list:"
    read name
    echo "Do you want to save that list as:"
    echo "${i_h_p}_list${name}_${ts} ?"
    ask
    if [ "$?" == 0 ]; then
        touch ${i_h_p}_list${name}_${ts}
        echo "cat $TMP/${i_h_p}_list"
        cat $TMP/${i_h_p}_list
        read FAKE
        echo "ls -l ${i_h_p}_list${name}_${ts}"
        ls -l ${i_h_p}_list${name}_${ts}
        read FAKE
        echo \$TMP: $TMP
        cat $TMP/${i_h_p}_list|wc -l
        list_nr_lines=$(cat $TMP/${i_h_p}_list|wc -l)
        echo \$list_nr_lines: $list_nr_lines
        grep -v '_list' $TMP/${i_h_p}_list > ${i_h_p}_list${name}_${ts}
        list_nr_lines_minus=$(cat ${i_h_p}_list${name}_${ts}|wc -l)
        echo \$list_nr_lines_minus: $list_nr_lines_minus
        ls -l ${i_h_p}_list${name}_${ts}
        cat ${i_h_p}_list${name}_${ts}
    else
        echo "list not saved by user choice"
    fi
    # Before termination of all created jobs, sync ${i_h_p}.pcap and $scr
    # (likely its derivative). Note that there's no talk if no .$scrg2_base.CMD_advise
    if [ -e ".$scrg2_base-0" ]; then
        if [ -s ".$scrg2_base-0" ]; then
            ls -l .$scrg2_base-0
            cat .$scrg2_base-0
            echo "(cat .$scrg2_base-0)"
            ls -l .$scrg2_base-0
        else
            echo "Pls. input the offset to cut $scr from into the filename:"
            ls -l .$scrg2_base-0
            echo "with sole content of Nhour:NNsec.NNNmilisec of the offset"
            echo "such as "0:03.500" without quotes."
            echo "WARNING: I'm doing no error checking!"
            read $offset
            if [ -z "$offset" ]; then
                echo "$offset" > .$scrg2_base-0
                echo "You gave:"
                cat .$scrg2_base-0
                echo "(cat .$scrg2_base-0)"
                echo "and you be  the judge if that's fine."
            fi
        fi
    else
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo ".$scrg2_base-0 does not exist"
        fi
    fi
    if [ -e ".$scrg2_base.CMD_pre" ]; then
        cat .$scrg2_base.CMD_pre
        echo "(cat .$scrg2_base.CMD_pre)"
        ls -l .$scrg2_base.CMD_pre
    else
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo ".$scrg2_base.CMD_pre does not exist"
        fi
    fi
    if [ -e ".$scrg2_base.CMD" ]; then
        cat .$scrg2_base.CMD
        echo "(cat .$scrg2_base.CMD)"
        ls -l .$scrg2_base.CMD
    else
        if [ -e ".$scrg2_base.CMD_advise" ]; then
            echo "Pls. mend for the above missing requisites,"
            echo "(in case any is missing)"
            echo "We next will try and create .$scrg2_base.CMD"
            echo "(needed for archiving, when only $scr_bare is kept)"
            echo "and hit Enter"
            read FAKE_permanent
            if [ -e ".$scrg2_base-0" ] && [ -s ".$scrg2_base-0" ] && [ -e ".$scrg2_base.CMD_pre" ]; then 
                parts_start=$(<.$scrg2_base-0)
                echo \$parts_start: $parts_start
                cat .$scrg2_base.CMD_pre >> .$scrg2_base.CMD
                if [ "$parts_start" != "0:00.000" ]; then
                    echo "mkvmerge -o ${scrg2_base}-0.mkv --split parts:$parts_start- $scrg2" \
                        >> .$scrg2_base.CMD
                    mkvmerge -o ${scrg2_base}-0.mkv --split parts:$parts_start- $scrg2
                else
                    echo "#mkvmerge -o ${scrg2_base}-0.mkv --split parts:$parts_start- $scrg2" \
                        >> .$scrg2_base.CMD
                    echo "mv -iv $scrg2 ${scrg2_base}-0.mkv" >> .$scrg2_base.CMD
                    mv -iv $scrg2 ${scrg2_base}-0.mkv
                    ln -s ${scrg2_base}-0.mkv $scrg2
                fi
                cat .$scrg2_base.CMD
                echo "(cat .$scrg2_base.CMD)"
                ls -l .$scrg2_base.CMD
            else
                echo "At least one of these two are inextant or empty:"
                ls -l .$scrg2_base-0 .$scrg2_base.CMD_pre
                echo "Not creating .$scrg2_base.CMD ."
                echo "Run uncenz-2nd again on ${i_h_p}.pcap"
                echo "or create .$scrg2_base.CMD manually."
            fi
        fi
    fi
    # Another job before termination is removal of $scr temps.
    if [ -e ".$scrg2_base.CMD_advise" ]; then
        rm -v .$scrg2_base.CMD_advise
    fi
    if [ -e ".$scrg2_base.CMD_pre" ]; then
        rm -v .$scrg2_base.CMD_pre
    fi
    if [ -e "$scrg2_0" ] && [ -e "$scrg2" ]; then
        # Mostly, if $scrg2_0, $scrg2 not needed
        rm -v $scrg2
        read FAKE
    fi
    if [ -e "$scrg2_0" ]; then
        # Keep $scrg2_0 or not? Probably remove. If short duration, easy to
        # recreate, if long, too large. However, on repeated analysis, keep
        # yet! So, ask with '-i'.
        ls -l $scrg2_0
        rm -iv $scrg2_0
    fi
    if [ -e ".pcaps-no-split" ]; then
        rm -v .pcaps-no-split
    fi
    echo "NOT terminate all windows opened with this run of ${0##/}?"
    echo "default: do terminate (just hit Enter)"
    echo "This choice will leave all windows opened,"
    echo "and the mplayer with the screencast running."
    ask
    if [ "$?" == 0 ]; then
        echo "All windows left open/running"
        echo "(excluding those not taken pid of in $TMP)"
    else
        for curjobs in $(ls -1 $TMP/${i}*_${hst_p}*.pid); do
            pid=$(cat $curjobs)
            echo \$pid: $pid
            echo kill $pid
            kill $pid
        done
        sleep 0.1
        rm -rf $TMP/
    fi
    trap "rm -rf $TMP/" EXIT INT TERM
    export TMP
done
ls -l $TMP
read FAKE
trap "rm -rf $TMP/" EXIT INT TERM
