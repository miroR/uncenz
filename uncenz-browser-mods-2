#!/bin/bash
#
# uncenz-browser-mods-2 --  see uncenz-browser-mods pls.
#                    Run as "uncenz-kill -r uncenz-browser-mods-2" to save the
#                    browser (and possibly user-) -written modifications for
#                    later analysis
