. /home/$USER/.uncenz.conf

# The usual conf is to drop all ipv6. Will need adjustments for more complex
# settings.
if [ "$IP6" != "y" ]; then
    #echo \$IP6: $IP6
    #echo "Meaning ip6tables must be set to DROP."
    # To open to ipv6 traffic set:
    # IP6=y in /home/$USER/.uncenz.conf)
    if ! ( sudo -s ip6tables -L -n | grep INPUT | grep -q DROP ) || \
       ! ( sudo -s ip6tables -L -n | grep FORWARD | grep -q DROP ) || \
       ! ( sudo -s ip6tables -L -n | grep OUTPUT | grep -q DROP ); then
       echo "ip6tables are not set right"
       echo "CAN NOT go online"
       read FAKE
       sudo -s ip6tables -L -n
       echo "(sudo -s ip6tables -L -n)"
        exit 1
    #else
    #    echo "ip6tables _are_ set to DROP."
    fi
else
    echo \$IP6: $IP6
    echo "Meaning ip6tables may be all at ACCEPT."
    echo "sudo -s ip6tables -L -n, next"
    read FAKE
    sudo -s ip6tables -L -n
    echo "(sudo -s ip6tables -L -n)"
    ask "Are you sure you want to allow this?"
    if [ "$?" == 0 ]; then
        echo "Continuing by user's choice."
    else
        echo "To make sure ip6tables are set to DROP set:"
        echo "IP6=n in /home/$USER/.uncenz.conf)"
        echo "sleep 3 and exit"
        sleep 3
        exit 0
    fi
fi

