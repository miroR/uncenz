. /home/$USER/.uncenz.conf

#echo ". uncenz-setup from ${0##*/}"
. uncenz-setup

if [ "$OHST_READY" == "n" ]; then
    echo hostname
    hostname
    echo "Must be OHST_READY=y in /home/$USER/.uncenz.conf"
    echo "sleep 3 and exit"
    sleep 3
    exit 0
fi

function show_help {
    echo
    echo "==============================================================="
    echo
    echo "${0##*/} -- terminates the spawned $dumper and ffmpeg/wf-recorder processes of uncenz,"
    echo "(terminates the packet capturing and screencasting)"
    echo
    echo "Usage: ${0##*/} <the-other-include>"
    echo "        (if run in the uncenz-1st)"
    echo ""
    echo "Pls. see also uncenz-1st."
    echo
}

hst=$(hostname|sed 's/\(...\).*/\1/')
ts=$(<$uncenz_run/uncenz-ts)
# Optional include here, named 2 because it's (usually) the back script (that's
# why the 2b) of the include 2 in uncenz-1st. Often both scripts must be there
# for this optional include, completely ignored if not there, to work. Only in
# uncenz-kill it's the first argument to $0, not the second.
# debug 5 ln
#echo \$1: $1
#cont_arg_1=$(echo $1 | grep '[[:print:]]')
#if [ "X${cont_arg_1}X" == "XX" ]; then
#    echo "arg \$1 is empty/non-extant:"
#fi
#if [ -z "$1" ] && [ -n "$1" ] && [ "X${1}X" != "XX" ]; then
#    include_script_2b=$1
#    echo \$include_script_2b: $include_script_2b
#    if [ -e "/usr/local/bin/$include_script_2b" ] && [ -x "/usr/local/bin/$include_script_2b" ]; then 
#            /usr/local/bin/$include_script_2b
#        else
#            echo "The include script you gave:"
#            echo "$include_script_2b"
#            echo "does not exist, or is not in the /usr/local/bin/ directory,"
#            echo "or is not executable"
#            show_help
#            sleep 3
#            echo "But you probably need to run the rest of ${0##*/}"
#            sleep 2
#    fi
#else
#            # Maybe better do nothing here, such as: 'echo -n', or no else at all?
#            echo "The include script you gave:"
#            echo "$include_script_2b"
#            echo "has not been supplied on the command line, or is an empty string,"
#fi
OPTIND=1
while getopts "hr:" opt; do
    case "$opt" in
        h)
            show_help
            exit 0
            ;;
        r)
            if [ "X$OPTARG" != "X" ]; then 
                if [ -e "/usr/local/bin/$OPTARG" ] && [ -x "/usr/local/bin/$OPTARG" ]; then
                    $OPTARG
                    sleep 0.20
                    if [ -e "$uncenz_run/${OPTARG}_calls_exit" ]; then
                        ls -l $uncenz_run/${OPTARG}_calls_exit
                        exit 1
                    fi
                fi
            else
                echo "You gave an empty argument, or something else is wrong."
            fi
            ;;
    esac
done
shift $(($OPTIND - 1))

# First thing to (regularly) do (the above snippet just opens more options) is
# take the excerpt from system log. We already have what to stick in the same
# $str0 (see uncenz-1st) taken after uncenz-1st did all it's starting of cast
# and trace taking/dumping.
str0=$(<$uncenz_run/uncenz-log_str0)
#echo \$str0: $str0
# 'str0' stands for 'string 0', i.e. from where in the log we will later, at
# termination of this session, grep out the excerpt of the log.
# In the same fashion we take the string for grep'ing on system log below, but
# we call it str1 this time.
#sudo -s tail -1 /var/log/kern.log
#sudo -s tail -1 /var/log/kern.log|cut -d\[ -f2|cut -d] -f1
# If it were kern.log:
#str1=$(sudo -s tail -1 /var/log/kern.log|cut -d\[ -f2|cut -d] -f1)
# If it is syslog:
#str1=$(sudo -s tail -1 /var/log/syslog|awk '{ print $1 }')
str1=$(sudo -s journalctl -o short-iso-precise -S-500 | tail -n1 | awk '{print $1}')
#echo \$str1: $str1
# (just no need to stick it into a file)
# 300000 is just a very likely sufficiently high integer
if [ -n "$str0" ] && [ -n "$str1" ]; then
    if [ "$str0" != "$str1" ]; then
        # if -aE no output, because 'man grep' meta-char + (and other) lose
        # special meaning, but previously this worked, must be recent change
        # e.g. str0=2020-06-14T05:27:47.284804+00:00 and
        # str1=2020-06-14T05:29:13.648601+00:00 output only without E
        #sudo -s cat /var/log/syslog | grep -a -A300000 $str0 \
        #    | grep -a -B300000 $str1 \
        #    > /home/$USER/.uncenz-1st/dump_${ts}_${hst}_messages
		sudo -s journalctl -o short-iso-precise -S$str0 -U$str1 \
            > /home/$USER/.uncenz-1st/dump_${ts}_${hst}_messages
    #else
    #    echo "working: dump_${ts}_${hst}_messages"
    #    echo "\$str0" and "\$str1 are identical"
    fi
fi
chmod 600 /home/$USER/.uncenz-1st/dump_${ts}_${hst}_messages
#ls -l /home/$USER/.uncenz-1st/dump_${ts}_${hst}_messages
if [ ! -s "/home/$USER/.uncenz-1st/dump_${ts}_${hst}_messages" ]; then
    rm -v /home/$USER/.uncenz-1st/dump_${ts}_${hst}_messages &> /dev/null
fi
#read NOP
dumper=$DUMPER
#echo \$dumper: $dumper
#read NOP
#echo \$hst: $hst
ssllast=SSLLAST_${ts}_${hst}.txt
#echo \$ssllast: $ssllast
ssllast_active=SSLLAST_${ts}_${hst}_active.txt
#echo \$ssllast_active: $ssllast_active
#read NOP
tail -1 $SSLKEYLOGFILE > /home/$USER/.uncenz-1st/$ssllast_active
#echo stored /home/$USER/.uncenz-1st/$ssllast_active ...
chmod 600 /home/$USER/.uncenz-1st/$ssllast_active
ls -l /home/$USER/.uncenz-1st/$ssllast \
    /home/$USER/.uncenz-1st/$ssllast_active
    ssllast_hash_active=$(sha256sum \
        /home/$USER/.uncenz-1st/$ssllast_active|cut -d' ' -f1)
#echo \$ssllast_hash_active: $ssllast_hash_active
#read NOP
    ssllast_hash=$(sha256sum \
        /home/$USER/.uncenz-1st/SSLLAST_$(<$uncenz_run/uncenz-ts.old)_${hst}.txt|cut -d' ' -f1)
#echo \$ssllast_hash: $ssllast_hash
#read NOP
#    echo \$ssllast_hash_active, then \$ssllast_hash:
#    echo $ssllast_hash_active
#    echo $ssllast_hash
if [ "$ssllast_hash_active" == "$ssllast_hash" ]; then
    echo
    echo "#####"
    echo
    # uncenz-kill is typically called to kill the session, even though it runs
    # if a session is not running, wording is for the typical case.
    echo " The last key taken during this session "
    echo " is the same as at the start of last session "
    echo
    echo " If \$SSLKEYLOGFILE enabled browser was active during this session"
    echo " and opened https pages, it may have malfunctioned. "
    echo
    echo "                            ^^^      ^^^^^^^^^^^^^ "
    aplay -q /home/$USER/tvtube.wav
    echo
    echo "But if no TLS-key logging browser was active, all may still be fine."
    echo
    echo "Hit Enter after you have read the above."
    echo
    read NOP
    echo
    echo "#####"
fi
rm /home/$USER/.uncenz-1st/$ssllast_active

if [ "$TERM" == "xterm" ]; then
    recpid=`sudo -s ps aux | grep -E 'ffmpeg' | grep -v grep | grep x11grab | awk '{ print $2}'`
fi
if [ "$TERM" == "foot" ]; then
    recpid=$(sudo -s ps aux | grep 'wf-recorder' | grep -v grep | grep hevc_vaapi \
        | grep renderD128 | awk '{ print $2 }')
fi

if [ "$dumper" == "dumpcap" ]; then
    dupid=`sudo -s ps aux | grep -E '[d]umpcap' | grep -v grep | awk '{ print $2}'`
fi
if [ "$dumper" == "tcpdump" ]; then
    dupid=`sudo -s ps aux | grep -E '[t]cpdump' | grep -v grep | awk '{ print $2}'`
fi
#echo \$recpid: $recpid
#echo \$dupid: $dupid

echo "To kill ffmpeg/wf-recorder and dumpcap/tcpdump, hit Enter"
# Or you can terminate this script without killing ffmpeg/wf-recorder and dumpcap/tcpdump
# with issuing: Ctrl-C (but the excerpt from system log for the session will
# not include what you do next from here).
read NOP

sudo -s kill -2 $dupid $recpid
#kill $dupid $recpid
if [ "$INTERIM" == "y" ]; then
    echo uncenz-inter.sh
    read NOP
    uncenz-inter.sh
fi
