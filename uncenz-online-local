echo ". uncenz-setup from ${0##*/}"
. uncenz-setup

. /home/$USER/.uncenz.conf

if [ ! -e "$uncenz_run/offlined-local" ]; then
    echo "The system wasn't offlined-local. No work to do for ${0##*/}."
    exit 0
fi
ask "exportfs -a -v ?"
if [ "$?" == 0 ]; then
    sudo -s exportfs -a -v
fi
ask "run mount-local.sh ?"
if [ "$?" == 0 ]; then
    sudo -s mount-local.sh
fi
