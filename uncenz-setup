myuid=$(id -u)
uncenz_run="/run/user/$myuid/uncenz"
if [ ! -e "$uncenz_run" ]; then
    mkdir $uncenz_run
    chmod 700 $uncenz_run
fi
# This line takes your hostname and retains only the first three letters to use
# in the infix
hst=$(hostname|sed 's/\(...\).*/\1/')
# I'll be running either xterm's under xorg or alacritty under wayland, either, never both.
if [ ! -n "$TERM" ]; then
    # Likely not needed, will else will always execute.
    ALACRITTY_CHK=$( ps aux | grep '\<alacritty\>' | grep -v grep )
    XTERM_CHK=$( ps aux | grep '\<xterm\>' | grep -v grep )
    read NOP
    if [ "X${ALACRITTY_CHK}" != "X" ] && [ "X${XTERM_CHK}" == "X" ]; then
        TERM="alacritty" 
    fi
    if [ "X${XTERM_CHK}" != "X" ] && [ "X${ALACRITTY_CHK}" == "X" ]; then
        TERM="xterm" 
    fi
#else
#    # TERM is a defined envvar, xorg or wayland, in my case, modify these scripts
#    # if your setup is different
#    echo -n "The envvar is: "
fi
