. /home/$USER/.uncenz.conf

# I have seen $SSLKEYLOGFILE on poorly maintained system, non-updated
# browser, diminishing, i.e. losing keys. We need to check that the
# append-only $SSLKEYLOGFILE is not losing content.
kl_size=$(ls -l $SSLKEYLOGFILE | awk '{ print $5 }')
kl_wc_l=$(wc -l $SSLKEYLOGFILE | awk '{ print $1 }')
kl_hash=$(sha256sum $SSLKEYLOGFILE | awk '{ print $1 }')
# We don't want to create but one only key log check file for all three above:
echo $kl_size $kl_wc_l $kl_hash > /home/$USER/.uncenz-1st/.kl_${tsh}_chk
chmod 600 /home/$USER/.uncenz-1st/.kl_${tsh}_chk
# All the 50 or more lines of code below only check if the previous session
# has lost keys... Boohoohoo... Still needed, I'd say...
# Aarrgh, we'll need to do a check when uncenz-kill is run too...
# In previous session, the /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk was made.
# When there were no previous sessions, we should copy the key log file to
# a fake old key log check file, else the code just next might break with
# errors.
if [ -e "/home/$USER/.uncenz-1st/.kl_${tsh_old}_chk" ]; then
    ls -l /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk
else
    cp -ia /home/$USER/.uncenz-1st/.kl_${tsh}_chk /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk
    echo "NOTE: we created a bogus old key log check file"
    echo "If you'll be consecutively running uncenz in this dir, this won't be recurring."
    echo "It happens only in the first session."
    read NOP
fi
# Needed only for learning/debugging. Should be commented out (3 ln).
echo "cat /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk"
cat /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk
read NOP
kl_size_old=$(awk '{ print $1 }' /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk)
kl_wc_l_old=$(awk '{ print $2 }' /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk)
kl_hash_old=$(awk '{ print $3 }' /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk)
# /home/$USER/.uncenz-1st/.kl_${tsh}_chk must have at least the same number of lines as old
if [ "$kl_wc_l" == "$kl_wc_l_old" ]; then
    # in which case the size and hash must also be same
    if [ "$kl_size" != "$kl_size_old" ]; then
        echo "Same number of lines ($kl_wc_l), but different size then before."
        echo "Check whether loss of data occurred with the key log!"
        read NOP
    # The else needed only for learning/debugging. Should be commented it.
    else
        echo \$kl_size: $kl_size
        echo \$kl_size_old: $kl_size_old
        read NOP
    fi
    if [ "$kl_hash" != "$kl_hash_old" ]; then
        echo "Same number of lines ($kl_wc_l), but different hash then before."
        echo "Check whether loss of data occurred with the key log!"
        read NOP
    # The else needed only for learning/debugging. Should be commented out.
    else
        echo \$kl_hash: $kl_hash
        echo \$kl_hash_old: $kl_hash_old
        read NOP
    fi
else
    # The first old number of lines, head'ed out, must have same size and
    # hash as in /home/$USER/.uncenz-1st/.kl_${tsh_old}_chk.
    head -${kl_wc_l_old} $SSLKEYLOGFILE > /home/$USER/.uncenz-1st/.kl_${tsh}_part
    chmod 600 /home/$USER/.uncenz-1st/.kl_${tsh}_part
    kl_size_part=$(ls -l /home/$USER/.uncenz-1st/.kl_${tsh}_part|awk '{ print $5 }')
    kl_hash_part=$(sha256sum /home/$USER/.uncenz-1st/.kl_${tsh}_part|awk '{ print $1 }')
    if [ "$kl_size_part" != "$kl_size_old" ]; then
        echo "For the portion of old number of lines ($kl_wc_l_old), sizes don't match."
        echo "Check whether loss of data occurred with the key log!"
        read NOP
    fi
    if [ "$kl_hash_part" != "$kl_hash_old" ]; then
        echo "For the portion of old number of lines ($kl_wc_l_old), hashes don't match."
        echo "Check whether loss of data occurred with the key log!"
        read NOP
    fi
    # Uncomment (1 ln) if script works well:
    #rm -v /home/$USER/.uncenz-1st/.kl_${tsh}_part
fi
        
#
# Pretty dirty, but does it for me, this below is for the purpose that I
# more easily find out if my browser, if active, is still
# logging TLS-keys. It will just compare the previous SSLLAST to the new
# just taken, by their hashes, and tell me to decide if they shouldn't
# differ, if they do.
tail -1 $SSLKEYLOGFILE > /home/$USER/.uncenz-1st/SSLLAST_${tsh}.txt
echo stored /home/$USER/.uncenz-1st/SSLLAST_${tsh}.txt ...
chmod 600 /home/$USER/.uncenz-1st/SSLLAST_${tsh}.txt
#ls -l /home/$USER/.uncenz-1st/SSLLAST_${tsh_old}.txt \
#    /home/$USER/.uncenz-1st/SSLLAST_${tsh}.txt
    ssllast_hash=$(sha256sum \
        /home/$USER/.uncenz-1st/SSLLAST_${tsh}.txt|cut -d' ' -f1)
    ssllast_hash_old=$(sha256sum \
        /home/$USER/.uncenz-1st/SSLLAST_${tsh_old}.txt|cut -d' ' -f1)
    #echo \$ssllast_hash, then \$ssllast_hash_old:
    #echo $ssllast_hash
    #echo $ssllast_hash_old
if [ "$ssllast_hash" == "$ssllast_hash_old" ]; then
    echo \$ssllast_hash, then \$ssllast_hash_old:
    echo $ssllast_hash
    echo $ssllast_hash_old
    echo
    echo "#####"
    echo
    echo " The last key is the same as at the start of last session "
    echo
fi
