. /home/$USER/.uncenz.conf

#echo ". uncenz-setup from ${0##*/}"
. uncenz-setup

# "ts" is for "time stamp"
ts=$(date +%y%m%d_%H%M)
#echo \$ts: $ts
tsh=${ts}_${hst}
#echo \$tsh: $tsh
if [ -e "$uncenz_run/uncenz-ts" ]; then
    cont_uncenz_ts=$(cat $uncenz_run/uncenz-ts | grep '[[:print:]]')
    if [ "X${cont_uncenz_ts}X" == "XX" ]; then
        echo "wrong so:"
        rm -v $uncenz_run/uncenz-ts
    fi
fi
if [ -e "$uncenz_run/uncenz-ts" ]; then
    ts_old=$(<$uncenz_run/uncenz-ts)
    #echo \$ts_old: $ts_old
    #read NOP
    echo $ts_old > $uncenz_run/uncenz-ts.old
    if [ -e "$uncenz_run/uncenz-ts.mod" ]; then
        ts_mod=$(<$uncenz_run/uncenz-ts.mod)
    fi
    if [ "$ts" == "$ts_old" ] || [ "$ts" == "$ts_mod" ]; then
        echo \$ts_old: $ts_old
        echo \$ts_mod: $ts_mod
        echo \$ts: $ts
        date
        echo "We won't overwrite the files just made."
        echo -e "Wait till this minute (or 2 in case of \$ts_mod) is over,\n\tthen run the script again,"
        echo "two sessions in the same minute\n\t(or 2 if there was need for creating \$ts_mod) is a bad idea."
        echo "Pls. cosider Ctrl-C now!"
        read NOP_permanent
    else
        echo $ts > $uncenz_run/uncenz-ts
        #echo cat $uncenz_run/uncenz-ts
        #cat $uncenz_run/uncenz-ts
    fi
else
    echo $ts > $uncenz_run/uncenz-ts
    #cat $uncenz_run/uncenz-ts
    #echo "(cat $uncenz_run/uncenz-ts)"
fi
